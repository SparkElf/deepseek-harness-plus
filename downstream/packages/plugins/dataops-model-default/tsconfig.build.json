{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "lib/types",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "composite": false,
    "incremental": false,
    "paths": {}
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
