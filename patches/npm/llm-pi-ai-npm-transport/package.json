{
  "name": "@sparkelf/dsh-patch-llm-pi-ai-npm-transport",
  "description": "Data-only patch teaching the published @sparkelf/dsh-llm-pi-ai build that a gateway-truncated response stream is a transport failure, so the default retry set retries it",
  "version": "0.2.1-alpha.28",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "patches/npm/llm-pi-ai-npm-transport"
  },
  "exports": {
    "./package.json": "./package.json",
    "./patches/llm-pi-ai-npm-transport.patch": "./patches/llm-pi-ai-npm-transport.patch"
  },
  "files": [
    "patches/*.patch"
  ],
  "license": "MIT",
  "dshPatch": {
    "formatVersion": 1,
    "variants": [
      {
        "id": "llm-pi-ai-npm-transport",
        "dsh": ">=0.2.0-rc.2",
        "target": {
          "kind": "npm",
          "name": "@sparkelf/dsh-llm-pi-ai",
          "range": ">=0.2.0 <0.3.0"
        },
        "file": "./patches/llm-pi-ai-npm-transport.patch"
      }
    ]
  }
}
