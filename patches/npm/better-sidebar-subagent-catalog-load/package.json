{
  "name": "@sparkelf/dsh-patch-better-sidebar-subagent-catalog-load",
  "description": "Data-only patch making dsh-better-sidebar request the catalog projection of every level its subagent tree renders",
  "version": "0.2.0-rc.28",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "patches/npm/better-sidebar-subagent-catalog-load"
  },
  "exports": {
    "./package.json": "./package.json",
    "./patches/better-sidebar-subagent-catalog-load.patch": "./patches/better-sidebar-subagent-catalog-load.patch"
  },
  "files": [
    "patches/*.patch"
  ],
  "license": "MIT",
  "dshPatch": {
    "formatVersion": 1,
    "variants": [
      {
        "id": "better-sidebar-subagent-catalog-load",
        "dsh": ">=0.1.7-rc.2",
        "target": {
          "kind": "npm",
          "name": "dsh-better-sidebar",
          "range": "0.21.1"
        },
        "file": "./patches/better-sidebar-subagent-catalog-load.patch"
      }
    ]
  }
}
