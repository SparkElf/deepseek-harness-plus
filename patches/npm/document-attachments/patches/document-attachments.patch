+import { useCallback, useRef } from 'react'
+import type { ChangeEvent } from 'react'
+import { IconPaperclipOutline16, Tooltip } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { ComposerAttachmentPickerProps } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import css from './AttachmentPicker.module.css'
+
+/**
+ * Render one image-and-document chooser directly after the command button.
+ * @param props - current intake availability, file callback, and localized labels.
+ * @returns the hidden file input and its visible attachment action.
+ */
+export function AttachmentPicker({ canAcceptFiles, onAddFiles, t }: ComposerAttachmentPickerProps) {
+  const fileInput = useRef<HTMLInputElement>(null)
+  const chooseFiles = useCallback(() => { fileInput.current?.click() }, [])
+  const onFilesChosen = useCallback((event: ChangeEvent<HTMLInputElement>) => {
+    const files = event.currentTarget.files
+    if (files !== null && files.length > 0) onAddFiles([...files])
+    event.currentTarget.value = ''
+  }, [onAddFiles])
+
+  return (
+    <>
+      <input
+        ref={fileInput}
+        className={css.fileInput}
+        type="file"
+        multiple
+        accept="image/png,image/jpeg,image/webp,image/gif,.pdf,.docx,.pptx,.xlsx"
+        disabled={!canAcceptFiles}
+        onChange={onFilesChosen}
+      />
+      <Tooltip label={t('attachment.add')} side="top" delayMs={500}>
+        <button
+          type="button"
+          className={css.trigger}
+          aria-label={t('attachment.add')}
+          disabled={!canAcceptFiles}
+          onMouseDown={(event) => { event.preventDefault() }}
+          onClick={chooseFiles}
+        >
+          <IconPaperclipOutline16 />
+        </button>
+      </Tooltip>
+    </>
+  )
+}
