+    right: 12px;
+    width: 40px;
+    height: 40px;
+  }
+
+  .close.mobileClose {
+    display: inline-flex;
+  }
+
+  .close.desktopClose {
+    display: none;
+  }
+
+  .options {
+    width: 100%;
+    max-width: 100%;
+    padding: 8px 16px max(24px, env(safe-area-inset-bottom));
+    box-sizing: border-box;
+    overflow-x: hidden;
+    overflow-wrap: break-word;
+  }
+}
