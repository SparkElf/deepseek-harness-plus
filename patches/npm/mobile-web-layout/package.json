{
  "name": "@sparkelf/dsh-patch-mobile-web-layout",
  "version": "0.1.0-rc.16",
  "description": "Data-only exact official-source patch keeping user-expanded phone navigation at half the AppFrame width",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "patches/npm/mobile-web-layout"
  },
  "type": "module",
  "files": [
    "patches/*.patch"
  ],
  "license": "MIT",
  "dshPatch": {
    "formatVersion": 1,
    "variants": [
      {
        "id": "mobile-web-half-width-navigation",
        "dsh": ">=0.1.3-alpha.1",
        "target": {
          "kind": "dsh-source",
          "baseRevision": "d347e703908d0406b7a7ef80e3a0e594d86b2215",
          "paths": [
            "packages/client/ui-layout/",
            "packages/client/ui-agent-preset/",
            "packages/client/ui-conversation/",
            "packages/client/ui-jobs/",
            "packages/client/ui-schedule/",
            "packages/client/ui-model-selection/",
            "packages/client/ui-settings-general/"
          ]
        },
        "file": "./patches/mobile-web-layout.patch"
      }
    ]
  }
}
