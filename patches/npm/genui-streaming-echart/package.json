{
  "name": "@sparkelf/dsh-patch-genui-streaming-echart",
  "description": "Temporary data-only patch for streamed EChart component completion in dsh-genui",
  "version": "0.1.0-rc.12",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "patches/npm/genui-streaming-echart"
  },
  "exports": {
    "./package.json": "./package.json",
    "./patches/streaming-echart-components.patch": "./patches/streaming-echart-components.patch"
  },
  "files": [
    "patches/*.patch"
  ],
  "license": "MIT",
  "dshPatch": {
    "formatVersion": 1,
    "variants": [
      {
        "id": "genui-streaming-echart-components",
        "dsh": ">=0.1.2-alpha.2",
        "target": {
          "kind": "npm",
          "name": "@changfenhuang/dsh-genui",
          "range": "0.9.6"
        },
        "file": "./patches/streaming-echart-components.patch"
      }
    ]
  }
}
