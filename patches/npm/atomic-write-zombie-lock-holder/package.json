{
  "name": "@sparkelf/dsh-patch-atomic-write-zombie-lock-holder",
  "description": "Data-only patch making dsh-atomic-write's stale-lock takeover recognize a zombie holder, whose PID still answers the signal probe and so blocked the lock forever",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "patches/npm/atomic-write-zombie-lock-holder"
  },
  "exports": {
    "./package.json": "./package.json",
    "./patches/atomic-write-zombie-lock-holder.patch": "./patches/atomic-write-zombie-lock-holder.patch"
  },
  "files": [
    "patches/*.patch"
  ],
  "license": "MIT",
  "dshPatch": {
    "formatVersion": 1,
    "variants": [
      {
        "id": "atomic-write-zombie-lock-holder",
        "dsh": ">=0.2.0-rc.2",
        "target": {
          "kind": "npm",
          "name": "@deepseek-ai/dsh-atomic-write",
          "range": ">=0.2.1-alpha.2 <0.3.0"
        },
        "file": "./patches/atomic-write-zombie-lock-holder.patch"
      }
    ]
  }
}
