+/**
+* Whether `pid` is a zombie: a holder that exited but was not reaped yet.
+*
+* Only Linux exposes this, and only through `/proc`: elsewhere the signal probe stays the
+* whole answer. A read failure proves nothing about the holder, so it reads as "still alive"
+* and leaves the lock alone, because taking a live holder's lock is the worse misjudgement.
+* @param pid - the positive int32 PID the lock record names.
+* @returns true only when `/proc/<pid>/stat` says the process is `Z`.
+*/
+function zombieState(pid) {
+	let stat;
+	try {
+		stat = process.getBuiltinModule("node:fs").readFileSync("/proc/" + String(pid) + "/stat", "utf8");
+	} catch {
+		return false;
+	}
+	// The command name sits in parentheses and may contain spaces or parentheses, so the
+	// fields after it are located from the LAST ")" rather than by splitting the whole line.
+	const close = stat.lastIndexOf(")");
+	if (close < 0 || close + 2 >= stat.length) return false;
+	return stat.charAt(close + 2) === "Z";
+}
