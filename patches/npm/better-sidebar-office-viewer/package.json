{
  "name": "@sparkelf/dsh-patch-better-sidebar-office-viewer",
  "description": "Office Viewer fit, fonts, fidelity, refresh and presentation controls for Better Sidebar",
  "version": "0.1.0-rc.20",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "patches/npm/better-sidebar-office-viewer"
  },
  "exports": {
    "./package.json": "./package.json",
    "./patches/viewer-experience.patch": "./patches/viewer-experience.patch"
  },
  "files": [
    "patches/*.patch"
  ],
  "license": "MIT",
  "dshPatch": {
    "formatVersion": 1,
    "variants": [
      {
        "id": "better-sidebar-office-viewer",
        "dsh": ">=0.1.3-alpha.1",
        "target": {
          "kind": "npm",
          "name": "@huanlin/dsh-plugin-better-sidebar-plugin-office",
          "range": "0.2.0"
        },
        "file": "./patches/viewer-experience.patch"
      }
    ]
  }
}
