{
  "name": "@sparkelf/dsh-patch-better-sidebar-alpha2-settings",
  "description": "Compatibility patch for Better Sidebar Settings registration on DSH alpha.2",
  "version": "0.1.0-rc.14",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "patches/npm/better-sidebar-alpha2-settings"
  },
  "exports": {
    "./package.json": "./package.json",
    "./patches/alpha2-settings.patch": "./patches/alpha2-settings.patch"
  },
  "files": [
    "patches/*.patch"
  ],
  "license": "MIT",
  "dshPatch": {
    "formatVersion": 1,
    "variants": [
      {
        "id": "better-sidebar-alpha2-settings",
        "dsh": ">=0.1.2-alpha.2",
        "target": {
          "kind": "npm",
          "name": "dsh-better-sidebar",
          "range": "0.17.1"
        },
        "file": "./patches/alpha2-settings.patch"
      }
    ]
  }
}
