{
  "name": "@sparkelf/dsh-patch-web-runtime-compat",
  "version": "0.2.1-rc.2",
  "description": "Data-only exact official-source patch republishing the bind-dependent webRuntime service beside its alpha.2 successor",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "patches/npm/web-runtime-compat"
  },
  "type": "module",
  "files": [
    "patches/*.patch"
  ],
  "license": "MIT",
  "dshPatch": {
    "formatVersion": 1,
    "variants": [
      {
        "id": "web-runtime-service-compat",
        "dsh": ">=0.2.1-alpha.2",
        "target": {
          "kind": "dsh-source",
          "baseRevision": "687f282e8625c6b8d11ff58211a90524be2e4317",
          "paths": [
            "packages/bundle/web-app/"
          ]
        },
        "file": "./patches/web-runtime-compat.patch"
      }
    ]
  }
}
