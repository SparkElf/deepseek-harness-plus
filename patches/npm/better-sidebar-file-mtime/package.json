{
  "name": "@sparkelf/dsh-patch-better-sidebar-file-mtime",
  "description": "Data-only patch showing each explorer row's last-modified time in dsh-better-sidebar",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "patches/npm/better-sidebar-file-mtime"
  },
  "exports": {
    "./package.json": "./package.json",
    "./patches/better-sidebar-file-mtime.patch": "./patches/better-sidebar-file-mtime.patch"
  },
  "files": [
    "patches/*.patch"
  ],
  "license": "MIT",
  "dshPatch": {
    "formatVersion": 1,
    "variants": [
      {
        "id": "better-sidebar-file-mtime",
        "dsh": ">=0.2.0-rc.2",
        "target": {
          "kind": "npm",
          "name": "dsh-better-sidebar",
          "range": ">=0.25.0 <0.26.0"
        },
        "file": "./patches/better-sidebar-file-mtime.patch"
      }
    ]
  }
}
