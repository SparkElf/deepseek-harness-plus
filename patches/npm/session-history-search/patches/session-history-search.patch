+/** Match a current checkpoint whose own immutable cut completes a listed header. */
+function listedCurrentIdentityMatches(stored: CheckpointIdentity, header: SessionHeader): boolean {
+  return stored.formatVersion === header.version
+    && stored.createdAt === header.createdAt
+    && stored.cwd === header.cwd
+    && stored.isSeeded === header.isSeeded
+    && typeof stored.inheritedEventCount === 'number'
+}
+
+/** Match a predecessor title to a listed lifecycle without interpreting its old cut. */
+function listedPredecessorIdentityMatches(stored: CheckpointIdentity, header: SessionHeader): boolean {
+  return (stored.formatVersion === undefined || stored.formatVersion < header.version)
+    && stored.createdAt === header.createdAt
+    && stored.cwd === header.cwd
+}
