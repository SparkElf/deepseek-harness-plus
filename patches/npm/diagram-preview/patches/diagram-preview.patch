+/* Diagram canvas: scrollable surface with an absolutely positioned node layer. */
+
+.frame {
+  box-sizing: border-box;
+  width: 100%;
+  height: 100%;
+  overflow: auto;
+  padding: 16px;
+  font-family: var(--dsw-font, sans-serif);
+}
+
+.canvas {
+  position: relative;
+}
+
+.edges {
+  position: absolute;
+  inset: 0;
+  overflow: visible;
+}
+
+.edge {
+  fill: none;
+  stroke: var(--dsw-color-border, #c8ccd4);
+  stroke-width: 1.5;
+}
+
+.node {
+  position: absolute;
+  display: flex;
+  align-items: center;
+  box-sizing: border-box;
+  padding: 6px 10px;
+  border: 1px solid var(--dsw-color-border, #c8ccd4);
+  border-radius: 6px;
+  background: var(--dsw-color-surface, #ffffff);
+}
+
+.label {
+  display: -webkit-box;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+  overflow: hidden;
+  font-size: 12px;
+  line-height: 1.35;
+  overflow-wrap: anywhere;
+}
+
+.failure {
+  padding: 16px;
+  color: var(--dsw-color-text-secondary, #6b7280);
+  font-size: 13px;
+}
diff --git a/packages/client/ui-sidebar-documentpreview/src/client/diagram/DiagramBody.tsx b/packages/client/ui-sidebar-documentpreview/src/client/diagram/DiagramBody.tsx
