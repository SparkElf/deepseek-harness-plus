{
  "name": "@sparkelf/dsh-patch-diagram-preview",
  "description": "Exact source patch rendering draw.io and XMind files as diagrams in the sidebar preview",
  "version": "0.2.1-alpha.29",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "patches/npm/diagram-preview"
  },
  "exports": {
    "./package.json": "./package.json",
    "./patches/diagram-preview.patch": "./patches/diagram-preview.patch"
  },
  "files": [
    "patches/*.patch"
  ],
  "license": "MIT",
  "dshPatch": {
    "formatVersion": 1,
    "variants": [
      {
        "id": "diagram-preview",
        "dsh": ">=0.2.1-alpha.2",
        "target": {
          "kind": "dsh-source",
          "baseRevision": "6851e496285b2c9670066fdd142e7e46da586649",
          "paths": [
            "packages/client/ui-sidebar-documentpreview/src/"
          ]
        },
        "file": "./patches/diagram-preview.patch"
      }
    ]
  }
}
