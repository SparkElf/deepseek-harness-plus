#!/usr/bin/env bash
#
# Build a deployable Plus release tree from an official DSH tag.
#
#   dsh-plus-mirror build --tag <official-git-tag> --into <path> [--runtime <version>] [--force]
#   dsh-plus-mirror check --mirror <path>
#
# This is a directory tree the supervisor serves, not a container image; none of these steps
# touch Docker. "Release tree" is the term used throughout because the previous wording invited
# two mistakes: "mirror" reads as a Docker image, and "create" does not say that the first thing
# it does is remove whatever is already there.
#
# Why this exists instead of a runbook:
#
# Promoting a Plus deployment onto a new official release is a fixed sequence the
# operator otherwise repeats by hand, and three of its steps fail only after the
# expensive build has already run:
#
#   1. the official tag has to be extracted into a fresh mirror,
#   2. this repository's reviewed patches have to apply to it,
#   3. the standalone manifest's peer overrides have to be regenerated for the new
#      runtime, or the profile install is rejected by the plugin compatibility gate,
#   4. the build has to run through `dsh-plus-build` so the client brand is injected,
#   5. the profile has to be created from the standalone manifest,
#   6. the @deepseek-ai scope has to be relinked to the mirror's own sources, and every
#      real directory that shadows a linked package replaced by the link, or the
#      profile reports DEFECTIVE and every tool call fails,
#   7. the profile's compatibility exemptions have to name the plugins whose published
#      peer ranges cannot match the new runtime.
#
# Every one of those was discovered by watching a promotion fail. The step that is
# easy to miss is 3: the distribution's own patch set carries peer ranges that were
# resolved when it was published, so a new runtime needs new exemptions and the
# regeneration only covers the standalone manifest, not the profile.
#
# Measured on the 0.2.0-rc.1 promotion: patching needed one signature fix, the
# exemption list grew from 5 to 14 entries, and the scope check reported nine shadowed
# directories that no script repaired.
set -euo pipefail

NODE_BIN=/root/.nvm/versions/node/v24.18.0/bin
export PATH="$NODE_BIN:$PATH"

# Registry the mirror's installs resolve from. The China mirror is the default because a
# promotion runs from a mainland host and registry.npmjs.org stalls there: measured on the
# 0.2.0-rc.1 promotion, an install against npmjs.org sat for nine minutes without resolving a
# single package, while the same install against npmmirror.com finished in seconds. Override
# with DSH_PLUS_REGISTRY when a release is too new for the mirror to have synced.
# The mirror is built from a mainland host, where the default mirror is the fast path for
# most packages. It also serves a handful of optional cross-platform tarballs by redirect the
# client cannot follow, so a fallback registry is available for those.
export DSH_PLUS_REGISTRY="${DSH_PLUS_REGISTRY:-https://registry.npmmirror.com}"
export DSH_PLUS_REGISTRY_FALLBACK="${DSH_PLUS_REGISTRY_FALLBACK:-https://registry.npmjs.org}"
export npm_config_registry="$DSH_PLUS_REGISTRY"
PLUS_REPO=${PLUS_REPO:-/root/projects/deepseek-harness-plus}

usage() {
  sed -n '2,14p' "$0"
  exit "${1:-0}"
}

# Report a step and its outcome, so an interrupted run says where it stopped.
step() { echo "  [mirror] $*"; }

# Refuse to remove a release a running deployment is using.
#
# create starts by deleting its target. Aimed at the tree a live service runs from, that removes
# the service runtime and every process loaded from it - including, when the command was issued
# from a session served by that tree, the very tool the command needs to repair its own mistake.
# Measured 2026-10-11: the rebuild took 3080 to 404 and left the issuing session unable to run any
# command for five rounds. The check is conservative by design: a wrong refusal costs --force, a
# wrong acceptance costs the running deployment.
assert_not_in_use() {
  local target="$1" force="$2" output="" status=0
  output="$("$NODE_BIN/node" /root/.dsh/supervisor/release-in-use.mjs --release "$target" 2>&1)" || status=$?
  [ "$status" -eq 0 ] && return 0
  echo "$output" >&2
  if [ "$force" = "1" ]; then
    echo "  [mirror] --force given: rebuilding a live release anyway" >&2
    return 0
  fi
  cat >&2 <<EOF

refusing to build into a release that is in use.

build removes its target, and the paths above currently name it. If any of them is the
deployment serving this session, the removal also takes the tool that would repair it.

Build into a new directory and switch to it instead:

    dsh-plus-mirror build --tag <tag> --into <tree>-next --runtime <version>
    dsh-plus-switch <tree>-next

Pass --force only when the target is genuinely not the running deployment.
EOF
  exit 2
}

# Refuse to write into a directory that already holds something.
#
# The command removes its target and rebuilds it, so aiming it at an existing tree destroys that
# tree. The in-use check above catches the case where the tree is the served release; this catches
# every other case, including a previous build that was interrupted and a directory an operator
# meant to keep. Both are refusals rather than warnings because the removal is the first step and
# nothing later can undo it.
#
# A build belongs in a new path followed by a switch, so an existing target is far more likely to be
# a mistake than an intention.
assert_target_is_new() {
  local target="$1" force="$2"
  [ -d "$target" ] || return 0
  local entries
  entries="$(ls -A "$target" 2>/dev/null | wc -l | tr -d " ")"
  [ "$entries" = "0" ] && return 0
  if [ "$force" = "1" ]; then
    echo "  [mirror] --force given: replacing the existing $entries entries in $target" >&2
    return 0
  fi
  cat >&2 <<EOF

refusing to build into a directory that already holds $entries entries.

    $target

build removes its target before writing, so continuing would delete those entries.
A build belongs in a new path, and the switch is a separate step:

    dsh-plus-mirror build --tag <tag> --into <tree>-next --runtime <version>
    dsh-plus-switch <tree>-next

Pass --force only when the existing contents are expendable.
EOF
  exit 2
}

# ── build ─────────────────────────────────────────────────────────────────────
cmd_build() {
  local tag="" mirror="" runtime="" force="0"
  while [ $# -gt 0 ]; do
    case "$1" in
      --tag) tag="$2"; shift 2 ;;
      --into) mirror="$2"; shift 2 ;;
      # The previous name is still accepted so an operator who runs the old spelling is told what
      # changed, rather than being left with an unrecognised option and no explanation.
      --mirror)
        echo "  [mirror] --mirror is now --into; the target is a release tree, not a container image" >&2
        mirror="$2"; shift 2 ;;
      --runtime) runtime="$2"; shift 2 ;;
      --force) force="1"; shift ;;
      *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
  done
  [ -n "$tag" ] && [ -n "$mirror" ] || usage 2
  [ -d "$PLUS_REPO" ] || { echo "PLUS_REPO does not exist: $PLUS_REPO" >&2; exit 2; }

  cd "$PLUS_REPO"
  git rev-parse -q --verify "refs/tags/$tag" >/dev/null || {
    echo "tag $tag is not present; fetch it first:" >&2
    echo "  git fetch upstream refs/tags/$tag:refs/tags/$tag" >&2
    exit 2
  }

  # Before the removal, not after: the damage these prevent is the removal itself.
  assert_not_in_use "$mirror" "$force"
  assert_target_is_new "$mirror" "$force"

  step "extracting $tag into $mirror"
  rm -rf "$mirror"
  mkdir -p "$mirror"
  git archive "$tag" | tar -x -C "$mirror"
  # The patch application below uses git apply, so the tree needs an index.
  ( cd "$mirror" && git init -q . && git add -A && git -c user.email=mirror@local -c user.name=mirror commit -qm "official $tag" )

  # The directory is what gets applied, but the distribution is what was reviewed, and those are two
  # facts nothing compared: a directory added without a declaration is applied unreviewed, and a
  # declaration whose directory is gone is skipped silently. Both directions are checked before
  # anything is applied, because the alternative is discovering the difference from a running tree.
  step "checking the reviewed patch set against the directory"
  if ! "$NODE_BIN/npx" tsx "$PLUS_REPO/scripts/standalone/verify-patch-manifest.ts" --repo "$PLUS_REPO"; then
    echo "  [mirror] the declared patch set and patches/npm disagree; nothing was applied" >&2
    exit 1
  fi

  step "applying the reviewed dsh-source patches"
  local applied=0 failed="" expected=0
  # Counted by a script rather than an inline `node -e`: the shell quoting inside a quoted string
  # does not survive a rewrite, and a miscounted expectation would fail the build for the wrong reason.
  local counter="$DSH_HOME/count-source-patches.mjs"
  [ -f "$counter" ] || counter="$PLUS_REPO/scripts/deploy/count-source-patches.mjs"
  expected="$("$NODE_BIN/node" "$counter" "$PLUS_REPO")"
  for manifest in "$PLUS_REPO"/patches/npm/*/package.json; do
    local dir patch
    dir="$(dirname "$manifest")"
    # Only a source patch lands in the mirror; an npm patch targets a third party.
    local kind
    kind="$("$NODE_BIN/node" -e "const m=require('$manifest');const v=m.dshPatch?.variants?.[0]?.target?.kind;process.stdout.write(v??'')" 2>/dev/null || true)"
    [ "$kind" = "dsh-source" ] || continue
    patch="$(ls "$dir"/patches/*.patch 2>/dev/null | head -n1)"
    [ -n "$patch" ] || continue
    if ( cd "$mirror" && git apply --3way "$patch" >/dev/null 2>&1 ); then
      applied=$((applied + 1))
    else
      failed="$failed $(basename "$dir")"
    fi
  done
  step "patches applied: $applied of $expected"
  [ -z "$failed" ] || { echo "  [mirror] FAILED patches:$failed" >&2; exit 1; }
  # A count is the only thing that catches a patch the loop skipped without failing: the glob and the
  # kind filter can both pass over one silently, and the build would then ship a tree missing a
  # reviewed change. Reported against the expected count rather than on its own.
  if [ "$applied" != "$expected" ]; then
    echo "  [mirror] applied $applied of $expected reviewed source patches" >&2
    exit 1
  fi

  # A patch that stops compiling is the failure the release boundary cannot see: git
  # apply reconciles a moved hunk by context, so a signature the patch calls still has
  # to exist. The host face compiles the packages these patches touch.
  step "typechecking the patched tree (host face)"
  if ! ( cd "$mirror" && npx tsc -b tsconfig.host.json >/tmp/dsh-plus-mirror-tsc.log 2>&1 ); then
    echo "  [mirror] typecheck failed; see /tmp/dsh-plus-mirror-tsc.log" >&2
    tail -n 20 /tmp/dsh-plus-mirror-tsc.log >&2
    exit 1
  fi

  if [ -n "$runtime" ]; then
    step "regenerating the standalone manifest for runtime $runtime"
    "$NODE_BIN/npx" tsx scripts/standalone/generate-manifest.ts \
      --distribution packages/bundle/plus \
      --out packages/standalone/plus-standalone/package.json \
      --runtime-version "$runtime"
    "$NODE_BIN/npx" tsx scripts/standalone/generate-manifest.ts \
      --distribution packages/bundle/plus \
      --out packages/standalone/dataops-standalone/package.json \
      --runtime-version "$runtime" --variant dataops
  fi

  step "building the mirror (brand profile official)"
  /root/.dsh/dsh-plus-build "$mirror"

  step "creating the profile from the standalone manifest"
  local standalone
  standalone="$("$NODE_BIN/node" -e "process.stdout.write(require('$PLUS_REPO/packages/standalone/plus-standalone/package.json').name+'@'+require('$PLUS_REPO/packages/standalone/plus-standalone/package.json').version)")"
  # `plugin add` writes a skeleton profile whose bundle list is the launcher's default, and the
  # distribution only rewrites it from `@sparkelf/dsh-plus`'s own installer - which reads the
  # *published* package, so a bundle this repository added is absent until it is republished. The
  # standalone manifest is the artifact this build just generated from the distribution, so it is
  # what the profile is written from: dependencies and bundles both, before the install that reads
  # them. Measured 2026-10-11: without this the profile kept one bundle where the manifest named
  # twenty-one, and every capability only the bundles mount was absent while the build passed.
  "$NODE_BIN/node" - "$mirror/profiles/plus/package.json" "$PLUS_REPO/packages/standalone/plus-standalone/package.json" <<'PROFILE'
const { existsSync, readFileSync, writeFileSync } = require("node:fs")
const { dirname, join } = require("node:path")
const [profilePath, standalonePath] = process.argv.slice(2)
const standalone = JSON.parse(readFileSync(standalonePath, "utf8"))
const declaration = standalone.dshPlusStandalone
if (declaration === undefined) throw new Error(standalonePath + " declares no dshPlusStandalone")
// The skeleton holds launcher defaults this build does not choose, so only the two lists the
// distribution owns are replaced and everything else the skeleton wrote is left alone.
const profile = existsSync(profilePath) ? JSON.parse(readFileSync(profilePath, "utf8")) : {}
profile.name = "dsh-profile-plus"
profile.private = true
profile.type = "module"
// `workspace:` ranges name packages this repository publishes and are kept in the manifest so the
// repository constraint gate accepts it; `pnpm pack` rewrites them to published versions for the
// registry installation. This profile is written from the source tree rather than from a packed
// tarball, so no rewrite happened and the protocol has to go: pnpm rejects it here with
// ERR_PNPM_WORKSPACE_PKG_NOT_FOUND, because the profile is not a member of this workspace.
const published = (spec) => String(spec).replace(/^workspace:/u, "")
// The profile names the standalone package itself, because that is the release this deployment is
// pinned to and what `plugin add` was asked to install. A build writes this before that add runs, so
// the entry is added here rather than inherited from the skeleton it has not written yet.
const distributionDependencies = Object.fromEntries(
  Object.entries(standalone.dependencies ?? {}).map(([name, spec]) => [name, published(spec)]),
)
distributionDependencies["@sparkelf/dsh-plus"] = standalone.version
distributionDependencies[standalone.name] = standalone.version
profile.dependencies = { ...(profile.dependencies ?? {}), ...distributionDependencies }
profile.dsh = { ...(profile.dsh ?? {}), profile: { ...(profile.dsh?.profile ?? {}), bundles: declaration.bundles } }
writeFileSync(profilePath, JSON.stringify(profile, null, 2) + "\n")
// The workspace settings matter as much as the manifest, and they are written here for the same
// reason: nothing else in this build writes them. `hoisted` is what makes the patch packages
// reachable - under pnpm's default symlinked layout a dependency's own dependencies live in the
// virtual store, so `materialize-npm-patches` looks for the distribution's patch packages at the
// profile root and finds none.
//
// Written as text rather than through a YAML library, because this runs before the profile has a
// node_modules and cannot import one: the schema here is three top-level keys this file owns.
const workspacePath = join(dirname(profilePath), "pnpm-workspace.yaml")
const workspace = existsSync(workspacePath) ? readFileSync(workspacePath, "utf8") : ""
const workspaceLines = workspace.split("\n")
const hasKey = (key) => workspaceLines.some((line) => line.startsWith(key + ":"))
const additions = []
if (!hasKey("packages")) additions.push("packages:", "  - .")
if (!hasKey("nodeLinker")) additions.push("nodeLinker: hoisted")
if (!hasKey("autoInstallPeers")) additions.push("autoInstallPeers: false")
if (additions.length > 0) {
  const separator = workspace === "" || workspace.endsWith("\n") ? "" : "\n"
  writeFileSync(workspacePath, workspace + separator + additions.join("\n") + "\n")
}
console.log("  [mirror] profile declares " + String(Object.keys(profile.dependencies).length) + " dependencies and " + String(declaration.bundles.length) + " bundles")
PROFILE
  # The add is expected to report ignored build scripts on a first install: pnpm writes a
  # placeholder into the profile's allowBuilds and refuses the install, which is what the step
  # below answers. The failure is therefore not fatal, but the command must not wait for input
  # either: its stdin is /dev/null so an interactive prompt ends the process instead of hanging.
  #
  # A registry that cannot be reached produces the same exit status as that expected refusal, so the
  # two are told apart by what the profile holds afterwards. Measured 2026-10-11: an unreachable
  # registry left this step incomplete, and the build failed twenty minutes later at the mount check,
  # which named the symptom rather than the cause.
  if ! ( cd "$mirror" && DSH_HOME="$mirror" "$NODE_BIN/node" apps/cli/lib/bin.js plugin --profile plus add "$standalone" < /dev/null ); then
    if [ ! -f "$mirror/profiles/plus/package.json" ]; then
      echo "  [mirror] the profile was never created; a registry this install needs is unreachable" >&2
      exit 1
    fi
  fi

  # pnpm answers every un-reviewed native build with a placeholder in the profile's
  # pnpm-workspace.yaml and then refuses the install, so the profile is never created on
  # the first pass. The distribution records its decision; this applies it and installs
  # again, which is also the pass that creates the workspace links.
  step "resolving the profile's allowBuilds placeholders"
  "$NODE_BIN/node" /root/.dsh/dsh-plus-allow-builds \
    --profile "$mirror/profiles/plus" \
    --distribution "$PLUS_REPO/packages/bundle/plus/package.json"

  # The npm patches have to reach the workspace before the install that applies them. pnpm keys
  # them by name@version in patchedDependencies, and an entry added after an install disagrees with
  # the lockfile that install wrote, which makes pnpm refuse the next frozen install. Measured
  # 2026-10-11: the host mirror never ran this step at all, so three reviewed better-sidebar patches
  # were installed as packages and never applied, and the served tree ran the unpatched plugin.
  step "writing the npm patch configuration into the profile"
  "$NODE_BIN/node" "$DSH_HOME/supervisor/materialize-npm-patches.mjs" \
    --profile "$mirror/profiles/plus" \
    --distribution "$mirror/profiles/plus/node_modules/@sparkelf/dsh-plus"

  step "installing again with the build decisions in place"
  ( cd "$mirror/profiles/plus" && pnpm install --no-frozen-lockfile < /dev/null )

  # The profile is created by `plugin add`, which writes a skeleton from the launcher defaults and
  # then overwrites it with the manifest. When that overwrite does not happen the build still
  # succeeds and the profile keeps the skeleton - one bundle where the manifest names twenty. The
  # service then starts, never listens, and every plugin no bundle names is installed but never
  # mounted, which no later step detects. Measured 2026-10-11: that tree reached the served release
  # and had to be repaired by hand.
  step "checking the profile mounts what the manifest declares"
  if ! "$NODE_BIN/node" "$DSH_HOME/supervisor/verify-profile-bundles.mjs" \
      --profile "$mirror/profiles/plus" \
      --manifest "$PLUS_REPO/packages/standalone/plus-standalone/package.json"; then
    echo "  [mirror] refusing to finish: the built profile does not mount the declared bundles" >&2
    exit 1
  fi

  step "relinking the @deepseek-ai scope to the mirror's sources"
  "$NODE_BIN/node" /root/.dsh/supervisor/relink-release.mjs --release "$mirror" --profile "$mirror/profiles/plus"

  # The profile's scope must cover every package the mirror's own sources declare, not just
  # the ones the standalone manifest lists. A first relink from a freshly created profile
  # links the manifest's set; the mirror ships far more, and a package that resolves through
  # the profile rather than the tree (a plugin's own dependency on another @deepseek-ai
  # package, for instance) is absent until this second pass. Measured 2026-09-30: a profile
  # built without it held 78 links where the previous release held 329, and computer-use and
  # the schedule UI were among the packages a plugin could not resolve.
  step "relinking again over the mirror's full source set"
  "$NODE_BIN/node" /root/.dsh/supervisor/relink-release.mjs --release "$mirror" --profile "$mirror/profiles/plus"

  # The patch directories are the reviewed patches applied to published plugin packages, and
  # the profile is what the launcher patches against. They live under the profile rather than
  # the tree, so a newly created profile starts without them and every patched plugin loads
  # unpatched. Measured 2026-09-30: the previous release carried 18 patch directories and the
  # new one none, which silently cost the Office preview, the sidebar, and the mobile journal.
  # The state to carry lives in the release that is currently serving, which is whatever
  # profiles/plus resolves to -- not a sibling of the mirror being built. Deriving it from the
  # serving link is what makes this correct for a mirror at any path.
  step "carrying the reviewed patch directories into the profile"
  local serving
  serving="$(readlink -f /root/.dsh/profiles/plus 2>/dev/null || true)"
  # A mirror keeps its profile at profiles/plus, so both sides are named directly rather than
  # through a fixed child name.
  if [ -n "$serving" ] && [ -d "$mirror/profiles/plus" ]; then
    "$NODE_BIN/node" /root/.dsh/supervisor/carry-profile-state.mjs \
      --from-profile "$serving" \
      --to-profile "$mirror/profiles/plus" || true
  else
    echo "  no serving profile to carry from; the mirror keeps its own layer" >&2
  fi

  # The carried composition writes dependencies the profile did not have when the install above
  # ran, and carry-profile-state reports exactly that ("the profile needs an install for the
  # added dependencies") without installing them. A dependency added by hand -- a file: entry for
  # a local plugin, for instance -- therefore stayed declared and absent: the patch layer mounted
  # it by name, the module was never there, and the plugin silently did nothing. Measured
  # 2026-10-05: dsh-image-hoist was declared in every profile and installed in none.
  step "installing the carried dependencies"
  ( cd "$mirror/profiles/plus" && pnpm install --no-frozen-lockfile < /dev/null )

  # The compatibility gate evaluates the profile's grants, not the standalone
  # manifest's peer overrides: a plugin whose published range cannot match the new
  # runtime is rejected outright until an exemption names it. Deriving the list keeps
  # it in step with whatever the distribution currently pins.
  step "writing the profile compatibility exemptions"
  "$NODE_BIN/node" /root/.dsh/dsh-plus-exemptions \
    --runtime "${runtime:-}" \
    --manifest "$PLUS_REPO/packages/standalone/plus-standalone/package.json" \
    --out "$mirror/profiles/plus/compatibility.json"

  # The profile lives at profiles/plus, not at the `profile` the repair defaults to, so the
  # path is passed explicitly. Without it the repair finds no scope, reports "nothing to
  # repair", and the profile keeps the registry copies of every @deepseek-ai package: a
  # mirror in which `dsh-host-webserver` is alpha.1 beside an alpha.2 `dsh-web-app`, whose
  # `isWildcardHost` import then fails the whole tree.
  step "repairing shadowed packages"
  "$NODE_BIN/node" /root/.dsh/supervisor/repair-shadowed-scope.mjs \
    --release "$mirror" --profile "$mirror/profiles/plus" || true

  # The workspace links the repair just made point at the release sources, which import
  # third-party packages that only the release root's own install provides.
  step "installing the release root"
  ( cd "$mirror" && pnpm install --no-frozen-lockfile < /dev/null ) || true

  step "done: $mirror"
  step "promote it with: dsh-plus-switch $mirror"
}

# ── check ─────────────────────────────────────────────────────────────────────
cmd_check() {
  local mirror=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --mirror) mirror="$2"; shift 2 ;;
      *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
  done
  [ -n "$mirror" ] || usage 2
  "$NODE_BIN/node" /root/.dsh/supervisor/check-profile-scope.mjs --release "$mirror" | tail -n 4
}

case "${1:-}" in
  build) shift; cmd_build "$@" ;;
  # The old spelling still runs, with a note, so a saved invocation keeps working while the operator
  # learns the new name. It is not advertised in the usage block.
  create)
    echo "  [mirror] create is now build; run: dsh-plus-mirror build --tag <tag> --into <tree>" >&2
    shift; cmd_build "$@" ;;
  check) shift; cmd_check "$@" ;;
  -h|--help|"") usage 0 ;;
  *) echo "unknown command: $1" >&2; usage 2 ;;
esac
