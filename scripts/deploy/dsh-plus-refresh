#!/usr/bin/env bash
#
# Refresh the Plus runtime that 3080 serves.
#
#   dsh-plus-refresh rebuild     rebuild the served tree after changing its source
#   dsh-plus-refresh accept      record the current profile as accepted
#   dsh-plus-refresh restart     accept, then restart the service
#   dsh-plus-refresh all         rebuild, then accept and restart
#   dsh-plus-refresh show        print the tree that would be rebuilt
#
# The supervisor's profile guard refuses to start when the accepted profile closure was
# modified without a new acceptance, and it is right to: the accept step is what records
# that a human reviewed the change. Skipping it makes every start fail until the profile
# is accepted again, so `accept` is part of this script rather than a step an operator
# has to remember.
#
# Which tree is rebuilt: the one the profile link currently points at, not a name written
# here. The mirror was hardcoded to plus-rc29 while the deployment served plus-021a5, so a
# rebuild compiled a tree nobody ran and still reported success - a silent no-op, because the
# compiled output of an unserved tree is never loaded. Resolving it from the link makes the
# rebuilt tree the served tree by construction.
set -euo pipefail

NODE=/root/.nvm/versions/node/v24.18.0/bin/node
GUARD=/root/.dsh/supervisor/profile-guard.mjs
PROFILE_LINK=/root/.dsh/profiles/plus
MANIFEST=/root/.dsh/supervisor/runtime.json
STATE=/root/.dsh/supervisor/accepted-profile.json
UNIT=deepseek-harness-plus.service
PORT=3080
LOG=/root/.dsh/dsh-plus-refresh.log

export PATH="/root/.nvm/versions/node/v24.18.0/bin:$PATH"

if [ "${1:-}" = "" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,20p' "$0"
  exit 0
fi

# The tree to rebuild is the one the profile link resolves to. The link points at
# <mirror>/profile or <mirror>/profiles/plus depending on how the release was assembled, so walk
# up until a directory holds apps/cli rather than assuming a fixed depth.
resolve_mirror() {
  local link dir
  link="$(readlink -f "$PROFILE_LINK" 2>/dev/null)" || { echo "[refresh] profile link does not resolve" >&2; return 1; }
  dir="$link"
  while [ "$dir" != "/" ] && [ -n "$dir" ]; do
    if [ -f "$dir/apps/cli/package.json" ]; then printf '%s' "$dir"; return 0; fi
    dir="$(dirname "$dir")"
  done
  echo "[refresh] no mirror with apps/cli above $link" >&2
  return 1
}

accept_profile() {
  echo "[refresh] preflight, then record the accepted profile"
  "$NODE" /root/.dsh/supervisor/preflight-start.mjs
}

rebuild() {
  local mirror
  mirror="$(resolve_mirror)"
  echo "[refresh] rebuilding $mirror $(date -Is)"
  cd "$mirror"
  pnpm run build:lib:host
  echo "[refresh] rebuild complete $(date -Is)"
}

restart_service() {
  accept_profile
  echo "[refresh] restarting $UNIT"
  systemctl restart "$UNIT"
  for _ in $(seq 1 60); do
    sleep 2
    ss -ltn 2>/dev/null | grep -q ":$PORT " && break
  done
  sleep 12
  echo "[refresh] health $(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$PORT/" 2>/dev/null)"
}

# `show` reports rather than acts, so it answers on the terminal. Everything that works is logged,
# and a report redirected into the log is a report nobody reads.
if [ "${1:-}" = show ]; then
  resolve_mirror
  echo
  exit 0
fi
exec >> "$LOG" 2>&1

case "${1:-}" in
  rebuild) rebuild ;;
  accept) accept_profile ;;
  restart) restart_service ;;
  all) rebuild; restart_service ;;
  *) echo "unknown command: $1" >&2; exit 2 ;;
esac