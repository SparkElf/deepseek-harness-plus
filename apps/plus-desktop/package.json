{
  "name": "@deepseek-ai/dsh-plus-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "DeepSeek Harness Plus system tray manager",
  "author": {
    "name": "SparkElf",
    "email": "58362707+SparkElf@users.noreply.github.com"
  },
  "homepage": "https://github.com/SparkElf/deepseek-harness-plus#readme",
  "desktopName": "deepseek-harness-plus",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "pnpm run prepare:source-ref && electron .",
    "preview:installer": "node scripts/preview-installer.mjs",
    "supervisor:command": "node src/supervisor-client.mjs",
    "prepare:source-ref": "node scripts/write-release-source-ref.mjs",
    "package:dir": "pnpm run prepare:source-ref && electron-builder --dir",
    "package:linux": "pnpm run prepare:source-ref && electron-builder --linux",
    "package:mac": "pnpm run prepare:source-ref && electron-builder --mac",
    "package:win": "pnpm run prepare:source-ref && electron-builder --win",
    "test:electron": "pnpm run prepare:source-ref && playwright test --config=playwright.config.mjs",
    "verify:unpacked-imports": "node scripts/verify-unpacked-imports.mjs",
    "package": "pnpm run prepare:source-ref && electron-builder"
  },
  "build": {
    "appId": "io.sparkelf.deepseek-harness-plus",
    "productName": "DeepSeek Harness Plus",
    "executableName": "DeepSeekHarnessPlus",
    "icon": "build/icon.png",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "progress/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "src/**/*.mjs",
      "node_modules/yaml/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "deepseek-harness-plus-${version}.${ext}",
      "category": "Development",
      "syncDesktopName": true,
      "maintainer": "SparkElf <58362707+SparkElf@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.49.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "pnpm": "11.7.0",
    "yaml": "^2.9.0"
  }
}
