{
  "name": "@deepseek-ai/dsh-plus-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness Plus system tray manager",
  "author": {
    "name": "SparkElf",
    "email": "58362707+SparkElf@users.noreply.github.com"
  },
  "homepage": "https://github.com/SparkElf/deepseek-harness-plus#readme",
  "desktopName": "deepseek-harness-plus",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron .",
    "supervisor:command": "node src/supervisor-client.mjs",
    "package:dir": "electron-builder --dir",
    "package:linux": "electron-builder --linux",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package": "electron-builder"
  },
  "build": {
    "appId": "io.sparkelf.deepseek-harness-plus",
    "productName": "DeepSeek Harness Plus",
    "executableName": "DeepSeekHarnessPlus",
    "electronDist": "node_modules/electron/dist",
    "icon": "build/icon.png",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "progress/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "deepseek-harness-plus-${version}.${ext}",
      "category": "Development",
      "syncDesktopName": true,
      "maintainer": "SparkElf <58362707+SparkElf@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
