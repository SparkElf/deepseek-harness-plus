        "@deepseek-ai/dsh-client-ui-conversation": "npm:@sparkelf/dsh-client-ui-conversation@0.1.6-alpha.2",
        "@deepseek-ai/dsh-client-ui-deliverables": "npm:@sparkelf/dsh-client-ui-deliverables@0.1.6-alpha.2",
        "@deepseek-ai/dsh-client-ui-layout": "npm:@sparkelf/dsh-client-ui-layout@0.1.6-alpha.2",
        "@deepseek-ai/dsh-client-ui-model-selection": "npm:@sparkelf/dsh-client-ui-model-selection@0.1.6-alpha.2",
        "@deepseek-ai/dsh-client-ui-primitives": "npm:@sparkelf/dsh-client-ui-primitives@0.1.6-alpha.2",
        "@deepseek-ai/dsh-client-ui-settings-models": "npm:@sparkelf/dsh-client-ui-settings-models@0.1.6-alpha.2",
        "@deepseek-ai/dsh-client-ui-trajectory": "npm:@sparkelf/dsh-client-ui-trajectory@0.1.6-alpha.2",
        "@deepseek-ai/dsh-host-frontend-static": "npm:@sparkelf/dsh-host-frontend-static@0.1.6-alpha.2",
        "@deepseek-ai/dsh-host-webserver": "npm:@sparkelf/dsh-host-webserver@0.1.6-alpha.2",
        "@deepseek-ai/dsh-llm-pi-ai": "npm:@sparkelf/dsh-llm-pi-ai@0.1.6-alpha.2",
        "@deepseek-ai/dsh-session-log-export": "npm:@sparkelf/dsh-session-log-export@0.1.6-alpha.2",
        "@deepseek-ai/dsh-tools": "npm:@sparkelf/dsh-tools@0.1.6-alpha.2",
        "@deepseek-ai/dsh-web-app": "npm:@sparkelf/dsh-web-app@0.1.6-alpha.2",
        "@deepseek-ai/dsh-web-frontend": "npm:@sparkelf/dsh-web-frontend@0.1.6-alpha.2",
        "@deepseek-ai/dsh-workspace": "npm:@sparkelf/dsh-workspace@0.1.6-alpha.2"
      }
    },
    "patchPackages": [
      "@sparkelf/dsh-patch-better-sidebar-media-path",
      "@sparkelf/dsh-patch-officecli-deliverables",
      "@sparkelf/dsh-patch-browser-auth-mode",
      "@sparkelf/dsh-patch-workspace-storage-restore",
      "@sparkelf/dsh-patch-subagent-settings-presets",
      "@sparkelf/dsh-patch-legacy-code-preset",
      "@sparkelf/dsh-patch-session-export-chinese",
      "@sparkelf/dsh-patch-session-log-trajectory-toolbar",
      "@sparkelf/dsh-patch-responses-reasoning-status",
      "@sparkelf/dsh-patch-ptc-mcp-schema-types",
      "@sparkelf/dsh-patch-web-base-path",
      "@sparkelf/dsh-patch-composer-popover-boundaries",
      "@sparkelf/dsh-patch-mobile-journal-generation",
      "@sparkelf/dsh-patch-session-format-legacy-restart"
    ],
    "sourceBase": {
      "revision": "0a15e36e7f82b6ed45af6fa9759f29b40dcd965d"
    }
  },
  "dependencies": {
    "@sparkelf/dsh-mobile-bridge": ">=0.2.11",
    "@sparkelf/dsh-patch-better-sidebar-media-path": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-browser-auth-mode": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-composer-popover-boundaries": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-legacy-code-preset": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-mobile-journal-generation": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-officecli-deliverables": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-ptc-mcp-schema-types": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-responses-reasoning-status": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-session-export-chinese": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-session-format-legacy-restart": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-session-log-trajectory-toolbar": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-subagent-settings-presets": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-web-base-path": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-patch-workspace-storage-restore": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-plugin-backup": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-plugin-dataops": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-plugin-mcp-credentials": "workspace:>=0.1.0-rc.26",
    "@sparkelf/dsh-plugin-subagent-settings": "workspace:>=0.1.0-rc.26",
    "dshmarket": ">=1.45.1",
    "semver": ">=7.7.3",
    "yaml": ">=2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "devDependencies": {
    "@changfenhuang/dsh-genui": "0.9.9",
    "@deepseek-ai/cordis": "workspace:^",
    "@types/semver": ">=7.7.1"
  },
  "bin": {
    "dsh-plus": "lib/bin.js"
  }
}
