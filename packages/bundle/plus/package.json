{
  "name": "@sparkelf/dsh-plus",
  "description": "DeepSeek Harness Plus official-base Web distribution profile and ranged compatibility patchset",
  "version": "0.1.0-rc.24",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/plus"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./apply": {
      "types": "./lib/types/apply.d.ts",
      "default": "./lib/apply.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/bin.js",
    "cordis.patch.yml",
    "lib/apply.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshPlus": {
    "formatVersion": 1,
    "compatibility": {
      "dsh": ">=0.1.5-alpha.2"
    },
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@sparkelf/dsh-mineru",
        "@sparkelf/dsh-officecli",
        "@sparkelf/dsh-mobile-bridge",
        "dshmarket",
        "@changfenhuang/dsh-genui",
        "@sparkelf/dsh-plugin-supervisor",
        "@sparkelf/dsh-plus",
        "dsh-sql-workbench",
        "@sparkelf/dsh-ssh-manager",
        "@sparkelf/dsh-api-client"
      ],
      "dependencies": {
        "@changfenhuang/dsh-genui": "0.9.8",
        "@sparkelf/dsh-mineru": "0.1.1",
        "@sparkelf/dsh-officecli": "0.1.1",
        "@sparkelf/dsh-plugin-supervisor": "0.1.4",
        "dsh-sql-workbench": "0.5.0",
        "@sparkelf/dsh-workbench-vault": "0.1.1",
        "@sparkelf/dsh-ssh-manager": "0.7.0",
        "@sparkelf/dsh-api-client": "0.5.0"
      },
      "allowBuilds": {
        "@officecli/officecli": true,
        "cpu-features": false,
        "node-pty": true,
        "oracledb": true,
        "protobufjs": false,
        "ssh2": true
      }
    },
    "patchPackages": [
      "@sparkelf/dsh-patch-officecli-deliverables",
      "@sparkelf/dsh-patch-browser-auth-mode",
      "@sparkelf/dsh-patch-workspace-storage-restore",
      "@sparkelf/dsh-patch-subagent-settings-presets",
      "@sparkelf/dsh-patch-legacy-code-preset",
      "@sparkelf/dsh-patch-session-export-chinese",
      "@sparkelf/dsh-patch-session-log-trajectory-toolbar",
      "@sparkelf/dsh-patch-responses-reasoning-status",
      "@sparkelf/dsh-patch-ptc-mcp-schema-types",
      "@sparkelf/dsh-patch-web-base-path",
      "@sparkelf/dsh-patch-composer-popover-boundaries",
      "@sparkelf/dsh-patch-mobile-journal-generation"
    ],
    "sourceBase": {
      "revision": "b2e3b2a0125854567a4a5fcba75782e42fe84901"
    }
  },
  "dependencies": {
    "@sparkelf/dsh-mobile-bridge": ">=0.2.11",
    "@sparkelf/dsh-patch-officecli-deliverables": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-patch-browser-auth-mode": "workspace:>=0.1.0-rc.24",
    "dshmarket": ">=1.45.1",
    "@sparkelf/dsh-plugin-backup": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-patch-workspace-storage-restore": "workspace:>=0.1.0-rc.24",
    "semver": ">=7.7.3",
    "yaml": ">=2.9.0",
    "@sparkelf/dsh-plugin-subagent-settings": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-patch-subagent-settings-presets": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-plugin-dataops": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-plugin-mcp-credentials": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-patch-web-base-path": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-patch-legacy-code-preset": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-patch-session-export-chinese": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-patch-session-log-trajectory-toolbar": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-patch-responses-reasoning-status": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-patch-ptc-mcp-schema-types": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-patch-composer-popover-boundaries": "workspace:>=0.1.0-rc.24",
    "@sparkelf/dsh-patch-mobile-journal-generation": "workspace:>=0.1.0-rc.24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "devDependencies": {
    "@changfenhuang/dsh-genui": "0.9.8",
    "@deepseek-ai/cordis": "workspace:^",
    "@types/semver": ">=7.7.1"
  },
  "bin": {
    "dsh-plus": "lib/bin.js"
  }
}
