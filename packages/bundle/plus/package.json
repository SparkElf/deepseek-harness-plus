{
  "name": "@sparkelf/dsh-plus",
  "description": "DeepSeek Harness Plus official-base Web distribution profile and ranged compatibility patchset",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/plus"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./apply": {
      "types": "./lib/types/apply.d.ts",
      "default": "./lib/apply.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshPlus": {
    "formatVersion": 1,
    "compatibility": {
      "dsh": ">=0.1.6-alpha.1"
    },
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@sparkelf/dsh-mineru",
        "@sparkelf/dsh-officecli",
        "@sparkelf/dsh-mobile-bridge",
        "dshmarket",
        "@huanlin/dsh-plugin-better-locale",
        "dsh-better-sidebar",
        "@sparkelf/dsh-plugin-better-sidebar-office",
        "@sparkelf/dsh-office-viewer-fonts",
        "dsh-video-preview",
        "@changfenhuang/dsh-genui",
        "@sparkelf/dsh-plugin-supervisor",
        "@sparkelf/dsh-plus",
        "dsh-sql-workbench",
        "@sparkelf/dsh-ssh-manager",
        "@sparkelf/dsh-api-client"
      ],
      "dependencies": {
        "@changfenhuang/dsh-genui": "0.9.9",
        "@sparkelf/dsh-mineru": "0.1.2",
        "@sparkelf/dsh-officecli": "0.1.2",
        "@sparkelf/dsh-plugin-supervisor": "0.1.5",
        "dsh-sql-workbench": "0.5.1",
        "@sparkelf/dsh-workbench-vault": "0.1.2",
        "@sparkelf/dsh-ssh-manager": "0.7.2",
        "@sparkelf/dsh-api-client": "0.5.1",
        "@huanlin/dsh-plugin-better-locale": "0.4.1",
        "dsh-better-sidebar": "0.19.1",
        "@sparkelf/dsh-plugin-better-sidebar-office": "0.2.1",
        "@sparkelf/dsh-office-viewer-fonts": "0.1.2",
        "dsh-video-preview": "0.1.4"
      },
      "allowBuilds": {
        "@deepseek-ai/dsh-subprocess-local": true,
        "@google/genai": false,
        "@officecli/officecli": true,
        "cpu-features": false,
        "koffi": true,
        "node-pty": true,
        "oracledb": true,
        "protobufjs": false,
        "ssh2": true
      },
      "overrides": {
        "@deepseek-ai/dsh-agent-presets": "npm:@sparkelf/dsh-agent-presets@0.1.6-alpha.2",
        "@deepseek-ai/dsh-api-gateway": "npm:@sparkelf/dsh-api-gateway@0.1.6-alpha.2",
