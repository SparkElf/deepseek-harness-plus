{
  "name": "@sparkelf/dsh-plus",
  "description": "DeepSeek Harness Plus official-base Web distribution profile and ranged compatibility patchset",
  "version": "0.1.0-rc.19",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "packages/bundle/plus"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./apply": {
      "types": "./lib/types/apply.d.ts",
      "default": "./lib/apply.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/bin.js",
    "cordis.patch.yml",
    "lib/apply.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshPlus": {
    "formatVersion": 1,
    "compatibility": {
      "dsh": ">=0.1.3-alpha.1"
    },
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "dsh-better-sidebar",
        "@sparkelf/dsh-office-viewer-fonts",
        "@huanlin/dsh-plugin-better-sidebar-plugin-office",
        "dsh-video-preview",
        "@sparkelf/dsh-mineru",
        "@sparkelf/dsh-officecli",
        "@sparkelf/dsh-mobile-bridge",
        "dshmarket",
        "@changfenhuang/dsh-genui",
        "@sparkelf/dsh-plugin-supervisor",
        "@sparkelf/dsh-plus",
        "dsh-sql-workbench",
        "@sparkelf/dsh-ssh-manager",
        "@sparkelf/dsh-api-client"
      ],
      "dependencies": {
        "@changfenhuang/dsh-genui": "0.9.8",
        "dsh-better-sidebar": "https://github.com/SparkElf/deepseek-harness-plus/releases/download/plus-v0.6.0/dsh-better-sidebar-0.18.1.tgz",
        "@sparkelf/dsh-office-viewer-fonts": ">=0.1.0",
        "@huanlin/dsh-plugin-better-sidebar-plugin-office": "0.2.0",
        "dsh-video-preview": "0.1.4",
        "@sparkelf/dsh-mineru": ">=0.1.0",
        "@sparkelf/dsh-officecli": ">=0.1.0",
        "@sparkelf/dsh-plugin-supervisor": "https://github.com/SparkElf/deepseek-harness-plus/releases/download/plus-v0.6.0/sparkelf-dsh-plugin-supervisor-0.1.3.tgz",
        "dsh-sql-workbench": "https://github.com/SparkElf/deepseek-harness-plus/releases/download/plus-v0.6.0/dsh-sql-workbench-0.4.0.tgz",
        "@sparkelf/dsh-workbench-vault": "https://github.com/SparkElf/deepseek-harness-plus/releases/download/plus-v0.6.0/sparkelf-dsh-workbench-vault-0.1.0.tgz",
        "@sparkelf/dsh-ssh-manager": "https://github.com/SparkElf/deepseek-harness-plus/releases/download/plus-v0.6.0/sparkelf-dsh-ssh-manager-0.6.0.tgz",
        "@sparkelf/dsh-api-client": "https://github.com/SparkElf/deepseek-harness-plus/releases/download/plus-v0.6.0/sparkelf-dsh-api-client-0.4.2.tgz"
      },
      "allowBuilds": {
        "@officecli/officecli": true,
        "cpu-features": false,
        "node-pty": true,
        "oracledb": true,
        "protobufjs": false,
        "ssh2": true
      }
    },
    "patchPackages": [
      "@sparkelf/dsh-patch-better-sidebar-office-viewer",
      "@sparkelf/dsh-patch-officecli-deliverables",
      "@sparkelf/dsh-patch-browser-auth-mode",
      "@sparkelf/dsh-patch-workspace-storage-restore",
      "@sparkelf/dsh-patch-session-history-search",
      "@sparkelf/dsh-patch-subagent-settings-presets",
      "@sparkelf/dsh-patch-legacy-code-preset",
      "@sparkelf/dsh-patch-session-export-chinese",
      "@sparkelf/dsh-patch-session-log-trajectory-toolbar",
      "@sparkelf/dsh-patch-responses-reasoning-status",
      "@sparkelf/dsh-patch-ptc-mcp-schema-types",
      "@sparkelf/dsh-patch-mobile-web-layout",
      "@sparkelf/dsh-patch-web-base-path"
    ],
    "sourceBase": {
      "revision": "d347e703908d0406b7a7ef80e3a0e594d86b2215"
    }
  },
  "dependencies": {
    "@sparkelf/dsh-mobile-bridge": ">=0.2.10",
    "@sparkelf/dsh-patch-better-sidebar-office-viewer": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-officecli-deliverables": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-browser-auth-mode": ">=0.1.0-rc.19",
    "dshmarket": ">=1.43.0",
    "@sparkelf/dsh-plugin-backup": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-workspace-storage-restore": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-session-history-search": ">=0.1.0-rc.19",
    "semver": ">=7.7.3",
    "yaml": ">=2.9.0",
    "@sparkelf/dsh-plugin-subagent-settings": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-subagent-settings-presets": ">=0.1.0-rc.19",
    "@sparkelf/dsh-plugin-dataops": ">=0.1.0-rc.19",
    "@sparkelf/dsh-plugin-mcp-credentials": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-mobile-web-layout": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-web-base-path": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-legacy-code-preset": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-session-export-chinese": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-session-log-trajectory-toolbar": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-responses-reasoning-status": ">=0.1.0-rc.19",
    "@sparkelf/dsh-patch-ptc-mcp-schema-types": ">=0.1.0-rc.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-invariants": ">=0.1.3-alpha.1"
  },
  "devDependencies": {
    "@changfenhuang/dsh-genui": "0.9.8",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@types/semver": ">=7.7.1",
    "dsh-better-sidebar": "0.18.0",
    "@huanlin/dsh-plugin-better-sidebar-plugin-office": "0.2.0",
    "dsh-video-preview": "0.1.4"
  },
  "bin": {
    "dsh-plus": "lib/bin.js"
  }
}
