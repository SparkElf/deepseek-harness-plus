+/**
+ * Force one model's `reasoning.summary` to a chosen spelling, or drop it.
+ *
+ * pi-ai writes `summary: options?.reasoningSummary || 'auto'` whenever a
+ * Responses model reasons, so the field leaves even when nothing asked for it.
+ * A gateway that refuses the field therefore fails every reply from that model
+ * rather than merely omitting a summary, and only a payload hook can keep the
+ * field off the wire.
+ * @param payload - the request body pi-ai built.
+ * @param summary - the configured spelling, or `omit` to drop the field.
+ * @returns the adjusted body, or undefined to leave the request untouched.
+ */
+function applyReasoningSummary(payload: unknown, summary: PiAiReasoningSummary): unknown {
+  const request = payload as Record<string, unknown> & { reasoning?: Record<string, unknown> }
+  if (request.reasoning === undefined) return undefined
+  if (summary === 'omit') {
+    const { summary: _summary, ...reasoning } = request.reasoning
+    return { ...request, reasoning }
+  }
+  return { ...request, reasoning: { ...request.reasoning, summary } }
+}
+
+/**
+ * The payload hook a model needs, if any.
+ *
+ * One hook field is a function, so a model needing both adjustments gets a
+ * composition rather than one silently replacing the other.
+ * @param profile - the resolved route profile.
+ * @param model - the model being called, which may pin its own summary.
+ * @returns the `onPayload` option for this call, or an empty object.
+ */
+function payloadOptions(
+  profile: ResolvedPiAiProviderProfile,
+  model: Model<Api>,
+): { onPayload?: (payload: unknown, model: Model<Api>) => unknown } {
+  const hooks: ((payload: unknown) => unknown)[] = []
+  if (profile.responsesCompatibility?.omitReasoningInputStatus === true) hooks.push(omitReasoningInputStatus)
+  const summary = (model as { reasoningSummary?: PiAiReasoningSummary }).reasoningSummary
+  if (summary !== undefined) hooks.push(payload => applyReasoningSummary(payload, summary))
+  const [first, ...rest] = hooks
+  if (first === undefined) return {}
+  if (rest.length === 0) return { onPayload: first }
+  return {
+    onPayload: (payload: unknown): unknown => {
+      let current = payload
+      let changed = false
+      for (const hook of hooks) {
+        const next = hook(current)
+        if (next === undefined) continue
+        current = next
+        changed = true
+      }
+      return changed ? current : undefined
+    },
+  }
+}
