+
+.trajectoryButton:disabled {
+  color: var(--dsw-alias-label-dimmed);
+  cursor: wait;
+}
+
+.trajectoryButton span,
+.trajectoryButton svg { flex: none; }
+.trajectoryButton span { white-space: nowrap; }
+
