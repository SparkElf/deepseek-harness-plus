@@ -0,0 +1,165 @@
+/** System LibreOffice PDF rendering: serialization, output ownership, deadlines, and Kit delegation. */
+import { chmod, mkdtemp, readFile, rm, stat, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import type { Converter } from '@deepseek-ai/libreoffice-kit'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { resolveSystemSoffice, withSystemSoffice } from '../src/system-soffice.ts'
+
+const POSIX = process.platform !== 'win32'
+const roots: string[] = []
+
+async function scratch(): Promise<string> {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-system-soffice-'))
+  roots.push(root)
+  return root
+}
+
+async function fakeSoffice(body: string): Promise<string> {
+  const root = await scratch()
+  const path = join(root, 'soffice')
+  await writeFile(path, `#!/usr/bin/env node\n${body}`)
+  await chmod(path, 0o755)
+  return path
+}
+
+const CONVERT = `
+const fs = require('node:fs')
+const path = require('node:path')
+const args = process.argv.slice(2)
+const outdir = args[args.indexOf('--outdir') + 1]
+const input = args[args.length - 1]
+const delay = Number(process.env.FAKE_DELAY || 0)
+const lock = process.env.FAKE_LOCK
+if (lock !== undefined) {
+  try { fs.writeFileSync(lock, 'held', { flag: 'wx' }) }
+  catch { fs.appendFileSync(lock + '.overlap', '1') }
+}
+setTimeout(() => {
+  fs.writeFileSync(path.join(outdir, path.basename(input).replace(/\\.[^.]+$/, '.pdf')), '%PDF-1.7\\n')
+  if (lock !== undefined) fs.rmSync(lock, { force: true })
+}, delay)
+`
+
+function baseConverter(): Converter {
+  return {
+    backend: 'wasm',
+    render: vi.fn<Converter['render']>().mockRejectedValue(new Error('Kit render must not run')),
+    renderImages: vi.fn<Converter['renderImages']>().mockResolvedValue({ images: [] } as never),
+    convert: vi.fn<Converter['convert']>().mockRejectedValue(new Error('unexpected convert')),
+    recalculate: vi.fn<Converter['recalculate']>().mockRejectedValue(new Error('unexpected recalculate')),
+    dispose: vi.fn<Converter['dispose']>().mockResolvedValue(undefined),
+  }
+}
+
+afterEach(async () => {
+  await Promise.all(roots.splice(0).map(root => rm(root, { recursive: true, force: true })))
+})
+
+describe.skipIf(!POSIX)('system LibreOffice backend', () => {
+  it('resolves an explicit executable and reports a missing one', async () => {
+    const executable = await fakeSoffice('')
+    await expect(resolveSystemSoffice(executable)).resolves.toBe(executable)
+    await expect(resolveSystemSoffice(join(executable, 'missing'))).resolves.toBeUndefined()
+  })
+
+  it('renders a PDF and delegates every other Kit operation', async () => {
+    const root = await scratch()
+    const executable = await fakeSoffice(CONVERT)
+    const base = baseConverter()
+    const converter = withSystemSoffice(base, {
+      executable,
+      profileDirectory: join(root, 'profile'),
+      timeoutMs: 5_000,
+    })
+    const outputPath = join(root, 'output.pdf')
+    const result = await converter.render({ inputPath: join(root, 'input.docx'), outputPath })
+    expect(result).toEqual({ backend: 'native', missingFonts: [] })
+    expect(await readFile(outputPath, 'utf8')).toContain('%PDF-1.7')
+    await converter.renderImages({} as never)
+    expect(base.renderImages).toHaveBeenCalledTimes(1)
+    expect(base.render).not.toHaveBeenCalled()
+    expect(converter.backend).toBe('native')
+  })
+
+  it('serializes concurrent renders that share one profile', async () => {
+    const root = await scratch()
+    const executable = await fakeSoffice(CONVERT)
+    const lock = join(root, 'soffice.lock')
+    const converter = withSystemSoffice(baseConverter(), {
+      executable,
+      profileDirectory: join(root, 'profile'),
+      timeoutMs: 10_000,
+      env: { FAKE_DELAY: '250', FAKE_LOCK: lock },
+    })
+    await Promise.all([0, 1, 2].map(async (index) => {
+      await converter.render({ inputPath: join(root, `input-${index}.docx`), outputPath: join(root, `output-${index}.pdf`) })
+    }))
+    for (const index of [0, 1, 2]) {
+      await expect(stat(join(root, `output-${index}.pdf`))).resolves.toBeDefined()
+    }
+    await expect(stat(`${lock}.overlap`)).rejects.toMatchObject({ code: 'ENOENT' })
+  })
+
+  it('rejects with the published timeout code and kills the process', async () => {
+    const root = await scratch()
+    const executable = await fakeSoffice(CONVERT)
+    const converter = withSystemSoffice(baseConverter(), {
+      executable,
+      profileDirectory: join(root, 'profile'),
+      timeoutMs: 250,
+      env: { FAKE_DELAY: '5000' },
+    })
+    await expect(converter.render({ inputPath: join(root, 'input.docx'), outputPath: join(root, 'output.pdf') }))
+      .rejects.toMatchObject({ code: 'timeout' })
+    await expect(stat(join(root, 'output.pdf'))).rejects.toMatchObject({ code: 'ENOENT' })
+  })
+
+  it('rejects an already existing output path before starting LibreOffice', async () => {
+    const root = await scratch()
+    const executable = await fakeSoffice(CONVERT)
+    const outputPath = join(root, 'output.pdf')
+    await writeFile(outputPath, 'existing')
+    const converter = withSystemSoffice(baseConverter(), {
+      executable,
+      profileDirectory: join(root, 'profile'),
+      timeoutMs: 5_000,
+    })
+    await expect(converter.render({ inputPath: join(root, 'input.docx'), outputPath }))
+      .rejects.toMatchObject({ code: 'invalid-output' })
+    await expect(readFile(outputPath, 'utf8')).resolves.toBe('existing')
+  })
+
+  it('reports a missing PDF as invalid output', async () => {
+    const root = await scratch()
+    const executable = await fakeSoffice('process.exit(0)')
+    const converter = withSystemSoffice(baseConverter(), {
+      executable,
+      profileDirectory: join(root, 'profile'),
+      timeoutMs: 5_000,
+    })
+    await expect(converter.render({ inputPath: join(root, 'input.docx'), outputPath: join(root, 'output.pdf') }))
+      .rejects.toMatchObject({ code: 'invalid-output' })
+  })
+
+  it('honors cancellation before the queued render starts', async () => {
+    const root = await scratch()
+    const executable = await fakeSoffice(CONVERT)
+    const converter = withSystemSoffice(baseConverter(), {
+      executable,
+      profileDirectory: join(root, 'profile'),
+      timeoutMs: 10_000,
+      env: { FAKE_DELAY: '250' },
+    })
+    const first = converter.render({ inputPath: join(root, 'first.docx'), outputPath: join(root, 'first.pdf') })
+    const controller = new AbortController()
+    const second = converter.render(
+      { inputPath: join(root, 'second.docx'), outputPath: join(root, 'second.pdf') },
+      controller.signal,
+    )
+    controller.abort(new Error('cancelled by test'))
+    await expect(second).rejects.toThrow('cancelled by test')
+    await first
+    await expect(stat(join(root, 'second.pdf'))).rejects.toMatchObject({ code: 'ENOENT' })
+  })
+})
