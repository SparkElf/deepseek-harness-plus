index 0000000..6faaaca
--- /dev/null
+++ b/packages/document/office-kit/src/system-soffice.ts
@@ -0,0 +1,210 @@
+/** System LibreOffice PDF rendering for Linux hosts without a native LibreOfficeKit engine. */
+import { spawn } from 'node:child_process'
+import { constants } from 'node:fs'
+import { access, copyFile, mkdir, mkdtemp, readdir, rm, stat } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import type { Converter, RenderResult } from '@deepseek-ai/libreoffice-kit'
+
+/** One system LibreOffice installation and the profile directory its serialized runs share. */
+export interface SystemSofficeOptions {
+  /** Absolute `soffice` executable. */
+  readonly executable: string
+  /** Absolute user-installation profile directory; one profile serves one process at a time. */
+  readonly profileDirectory: string
+  /** Per-conversion deadline, including process startup. */
+  readonly timeoutMs: number
+  /** Extra environment values for the child process. */
+  readonly env?: NodeJS.ProcessEnv
+}
+
+/** Error carrying the published conversion code the provider maps to its own failures. */
+export class SystemSofficeError extends Error {
+  readonly code: string
+
+  /**
+   * @param code - Published conversion failure category.
+   * @param message - User-facing failure description.
+   * @param options - Standard error options.
+   */
+  constructor(code: string, message: string, options?: ErrorOptions) {
+    super(message, options)
+    this.name = 'SystemSofficeError'
+    this.code = code
+  }
+}
+
+const SOFFICE_NAMES = ['soffice', 'libreoffice'] as const
+const SOFFICE_LOCATIONS = ['/usr/bin', '/usr/local/bin', '/opt/libreoffice/program'] as const
+
+/**
+ * Resolve a system LibreOffice executable without a shell.
+ * @param explicit - Configured absolute or PATH-resolved executable.
+ * @returns absolute executable path, or undefined when none is installed.
+ */
+export async function resolveSystemSoffice(explicit?: string): Promise<string | undefined> {
+  if (explicit !== undefined) {
+    try {
+      await access(explicit, constants.X_OK)
+      return explicit
+    } catch {
+      return undefined
+    }
+  }
+  for (const directory of SOFFICE_LOCATIONS) {
+    for (const name of SOFFICE_NAMES) {
+      const candidate = join(directory, name)
+      try {
+        await access(candidate, constants.X_OK)
+        return candidate
+      } catch {
+        // Try the next conventional location.
+      }
+    }
+  }
+  for (const directory of (process.env.PATH ?? '').split(':').filter(Boolean)) {
+    for (const name of SOFFICE_NAMES) {
+      const candidate = join(directory, name)
+      try {
+        await access(candidate, constants.X_OK)
+        return candidate
+      } catch {
+        // Try the next PATH entry.
+      }
+    }
+  }
+  return undefined
+}
+
+/** One serialized queue per profile: LibreOffice cannot serve two processes from one user profile. */
+class SerialQueue {
+  private tail: Promise<unknown> = Promise.resolve()
+
+  /** Wait for every queued and active turn to settle. */
+  idle(): Promise<void> {
+    return this.tail.then(() => undefined)
+  }
+
+  run<T>(task: () => Promise<T>, signal?: AbortSignal): Promise<T> {
+    signal?.throwIfAborted()
+    const turn = this.tail.then(() => {
+      signal?.throwIfAborted()
+      return task()
+    })
+    this.tail = turn.catch(() => undefined)
+    return turn
+  }
+}
+
+const queues = new Map<string, SerialQueue>()
+
+function queueFor(profileDirectory: string): SerialQueue {
+  let queue = queues.get(profileDirectory)
+  if (queue === undefined) {
+    queue = new SerialQueue()
+    queues.set(profileDirectory, queue)
+  }
+  return queue
+}
+
+/**
+ * Wrap a Kit converter so PDF rendering uses system LibreOffice while every other operation stays on the
+ * original engine. The wrapper keeps the same serial render contract and reports a native backend.
+ * @param base - Converter created by LibreOfficeKit.
+ * @param options - Executable, profile, and deadline for system rendering.
+ * @returns converter whose `render()` runs system LibreOffice.
+ */
+export function withSystemSoffice<T extends Converter>(base: T, options: SystemSofficeOptions): T {
+  const queue = queueFor(options.profileDirectory)
+  const render = createSystemRender(options, queue)
+  return new Proxy(base, {
+    get(target, property) {
+      if (property === 'render') return render
+      if (property === 'backend') return 'native'
+      if (property === 'dispose') return async () => { await queue.idle(); await target.dispose() }
+      const value: unknown = Reflect.get(target, property, target)
+      return typeof value === 'function' ? value.bind(target) : value
+    },
+  }) as T
+}
+
+function createSystemRender(options: SystemSofficeOptions, queue: SerialQueue) {
+  return (request: { readonly inputPath: string; readonly outputPath: string }, signal?: AbortSignal): Promise<RenderResult> =>
+    queue.run(async () => {
+      signal?.throwIfAborted()
+      await mkdir(options.profileDirectory, { recursive: true, mode: 0o700 })
+      await assertFreshOutput(request.outputPath)
+      const scratch = await mkdtemp(join(tmpdir(), 'dsh-office-system-'))
+      try {
+        const args = [
+          '--headless', '--norestore', '--nolockcheck', '--nodefault', '--nofirststartwizard', '--nologo',
+          `-env:UserInstallation=${pathToFileURL(options.profileDirectory).href}`,
+          '--convert-to', 'pdf', '--outdir', scratch, request.inputPath,
+        ]
+        await runSoffice(options, args, signal)
+        const produced = (await readdir(scratch)).filter(name => name.toLowerCase().endsWith('.pdf'))
+        if (produced.length !== 1) {
+          throw new SystemSofficeError('invalid-output', `LibreOffice produced ${produced.length} PDF files.`)
+        }
+        await copyFile(join(scratch, produced[0] as string), request.outputPath, constants.COPYFILE_EXCL)
+        return { backend: 'native', missingFonts: [] }
+      } finally {
+        await rm(scratch, { recursive: true, force: true })
+      }
+    }, signal)
+}
+
+/** Reject an output path that already exists, matching the Kit render contract. */
+async function assertFreshOutput(outputPath: string): Promise<void> {
+  try {
+    await stat(outputPath)
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return
+    throw error
+  }
+  throw new SystemSofficeError('invalid-output', `Output path already exists: ${outputPath}`)
+}
+
+function runSoffice(options: SystemSofficeOptions, args: readonly string[], signal?: AbortSignal): Promise<void> {
+  return new Promise<void>((resolve, reject) => {
+    const child = spawn(options.executable, args, {
+      stdio: 'ignore',
+      detached: process.platform !== 'win32',
+      env: { ...process.env, ...options.env },
+    })
+    let settled = false
+    const finish = (error?: Error): void => {
+      if (settled) return
+      settled = true
+      clearTimeout(timer)
+      signal?.removeEventListener('abort', abort)
+      if (error === undefined) resolve()
+      else reject(error)
+    }
+    const kill = (): void => {
+      try {
+        if (child.pid !== undefined && process.platform !== 'win32') process.kill(-child.pid, 'SIGKILL')
+        else child.kill('SIGKILL')
+      } catch {
+        // The process already exited.
+      }
+    }
+    const timer = setTimeout(() => {
+      kill()
+      finish(new SystemSofficeError('timeout', `LibreOffice conversion exceeded ${options.timeoutMs} ms.`))
+    }, options.timeoutMs)
+    const abort = (): void => {
+      kill()
+      const reason: unknown = signal?.reason
+      finish(reason instanceof Error ? reason : new SystemSofficeError('cancelled', 'LibreOffice conversion cancelled.'))
+    }
+    signal?.addEventListener('abort', abort, { once: true })
+    child.once('error', (error) => {
+      finish(new SystemSofficeError('unavailable', `LibreOffice could not start: ${error.message}`, { cause: error }))
+    })
+    child.once('exit', (code, signalName) => {
+      finish(code === 0 ? undefined : new SystemSofficeError('failed', `LibreOffice exited with ${signalName ?? String(code)}.`))
+    })
+  })
+}
