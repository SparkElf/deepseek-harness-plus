+/** Disclosure filters narrow the skills a Session may list and load. */
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SkillRegistry, {
+  type SkillCandidate,
+  type SkillDefinition,
+  type SkillLookupOptions,
+  type SkillProvider,
+} from '@deepseek-ai/dsh-skill'
+
+function skill(name: string): SkillCandidate {
+  return {
+    name,
+    description: `${name} description.`,
+    invocation: { modelInvocable: true, userInvocable: true },
+    provider: 'memory',
+    source: 'memory',
+    rank: 10,
+    locator: { content: `${name} body.` },
+  }
+}
+
+class MemoryProvider implements SkillProvider {
+  readonly name = 'memory'
+  constructor(private readonly candidates: SkillCandidate[]) {}
+  async list(): Promise<SkillCandidate[]> {
+    return this.candidates
+  }
+  async get(candidate: SkillCandidate): Promise<SkillDefinition | undefined> {
+    return { ...candidate, content: (candidate.locator as { content: string }).content }
+  }
+}
+
+/** An agent Session stand-in carrying an opaque actor, or nothing. */
+const sessionWith = (actor?: unknown): { actor?: unknown } => actor === undefined ? {} : { actor }
+
+async function setup() {
+  const ctx = new Context()
+  await ctx.plugin(SkillRegistry)
+  ctx.skills.registerProvider(() => new MemoryProvider([skill('alpha'), skill('beta')]))
+  const names = async (options: SkillLookupOptions = {}): Promise<string[]> =>
+    (await ctx.skills.list(options)).map(entry => entry.name)
+  return { ctx, names }
+}
+
+describe('SkillRegistry visibility filters', () => {
+  it('keeps the catalog unchanged when nothing registers a filter', async () => {
+    const h = await setup()
+    expect(await h.names()).toEqual(['alpha', 'beta'])
+    expect(await h.names({ session: sessionWith({ permissions: ['alpha'] }) })).toEqual(['alpha', 'beta'])
+  })
+
+  it('hides only what a matching rule withholds, per Session', async () => {
+    const h = await setup()
+    h.ctx.skills.addVisibilityFilter({
+      appliesTo: candidate => candidate.name !== 'alpha',
+      // A rule sees `undefined` when the lookup names no Session and decides for itself; this one
+      // only narrows a real Session, so an administrative listing still reads the whole catalog.
+      hidden: session => session !== undefined && session.actor === undefined,
+    })
+
+    // A Session carrying an actor keeps the full catalog; one without it loses only what the rule
+    // claims, and `alpha` was never claimed.
+    expect(await h.names({ session: sessionWith({ permissions: ['alpha'] }) })).toEqual(['alpha', 'beta'])
+    expect(await h.names({ session: sessionWith() })).toEqual(['alpha'])
+    expect(await h.names()).toEqual(['alpha', 'beta'])
+  })
+
+  it('withholds load results too, so a hidden skill cannot be fetched by name', async () => {
+    const h = await setup()
+    h.ctx.skills.addVisibilityFilter({
+      appliesTo: candidate => candidate.name === 'beta',
+      hidden: session => session !== undefined && session.actor === undefined,
+    })
+
+    expect(await h.ctx.skills.get('beta', { session: sessionWith({}) })).toBeDefined()
+    expect(await h.ctx.skills.get('beta', { session: sessionWith() })).toBeUndefined()
+    // The same candidate is still loadable outside a Session, because this rule declines to narrow
+    // that case: hiding is about a Session's view, not the catalog.
+    expect(await h.ctx.skills.get('beta')).toBeDefined()
+  })
+
+  it('lets a rule treat a Session-less lookup as hidden when it chooses to', async () => {
+    const h = await setup()
+    h.ctx.skills.addVisibilityFilter({
+      appliesTo: () => true,
+      hidden: session => session?.actor === undefined,
+    })
+    // `undefined` reaches the rule like any other value; the base does not add a policy of its own.
+    expect(await h.names()).toEqual([])
+  })
+
+  it('leaves unclaimed and explicitly unhidden candidates alone', async () => {
+    const h = await setup()
+    h.ctx.skills.addVisibilityFilter({ appliesTo: () => false, hidden: () => true })
+    h.ctx.skills.addVisibilityFilter({ appliesTo: candidate => candidate.name === 'beta', hidden: () => false })
+    expect(await h.names({ session: sessionWith() })).toEqual(['alpha', 'beta'])
+  })
