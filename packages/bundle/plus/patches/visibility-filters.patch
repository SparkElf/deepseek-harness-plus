index 00000000..d6006337
--- /dev/null
+++ b/packages/core/tools/tests/visibility.spec.ts
@@ -0,0 +1,136 @@
+/** Disclosure filters narrow the step's model-facing tool set without touching programmatic reads. */
+import { afterEach, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import * as NativeToolExecutor from '@deepseek-ai/dsh-tool-executor-native'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineTool } from '@deepseek-ai/dsh-tools'
+
+const TEST_MODEL_SELECTION = { provider: 'test', model: 'test' }
+const contexts: Context[] = []
+afterEach(async () => {
+  for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+})
+
+/** An agent whose Session carries an opaque actor, or no Session at all. */
+function agentWith(id: string, actor?: unknown): Agent {
+  return {
+    id: SessionId(id),
+    ...actor === undefined ? {} : { session: { actor } },
+  } as unknown as Agent
+}
+
+const tool = (name: string) => defineTool({
+  name,
+  description: `The ${name} operation.`,
+  parameters: {},
+  output: { schema: { type: 'string' }, render: (_args, value) => [{ type: 'text', text: value }] },
+  async execute() { return name },
+})
+
+async function setup() {
+  const ctx = new Context()
+  contexts.push(ctx)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(NativeToolExecutor)
+  ctx.tools.register(tool('toolA'))
+  ctx.tools.register(tool('toolB'))
+  const controller = new AbortController()
+  const names = async (agent: Agent): Promise<string[]> => {
+    const toolSet = await ctx.tools.resolve({ agent, modelSelection: TEST_MODEL_SELECTION, signal: controller.signal })
+    try {
+      return ctx.tools.schemas(agent, toolSet).map(schema => schema.name)
+    } finally {
+      toolSet.dispose()
+    }
+  }
+  return { ctx, names, signal: controller.signal }
+}
+
+it('keeps the whole set when nothing registers a filter', async () => {
+  const h = await setup()
+  // The registry is opt-in: with no rule the step sees exactly what it saw before.
+  expect(await h.names(agentWith('a', { permissions: ['toolA'] }))).toEqual(['toolA', 'toolB'])
+  expect(await h.names(agentWith('b'))).toEqual(['toolA', 'toolB'])
+})
+
+it('hides only the tools a matching rule withholds, per Session', async () => {
+  const h = await setup()
+  // A connector that knows which tools need an identity hides everything but its own tool when the
+  // Session carries no actor. The rule never sees toolA, so that tool is unaffected.
+  h.ctx.tools.addVisibilityFilter({
+    appliesTo: definition => definition.name !== 'toolA',
+    hidden: session => session?.actor === undefined,
+  })
+
+  expect(await h.names(agentWith('with-actor', { permissions: ['toolA'] }))).toEqual(['toolA', 'toolB'])
+  expect(await h.names(agentWith('without-actor'))).toEqual(['toolA'])
+})
+
+it('leaves unclaimed and explicitly unhidden tools alone', async () => {
+  const h = await setup()
+  h.ctx.tools.addVisibilityFilter({ appliesTo: () => false, hidden: () => true })
+  h.ctx.tools.addVisibilityFilter({ appliesTo: definition => definition.name === 'toolB', hidden: () => false })
+
+  // Neither rule claims toolA, and the one that claims toolB declines to hide it.
+  expect(await h.names(agentWith('plain'))).toEqual(['toolA', 'toolB'])
+})
+
+it('restores the full set when the registration is disposed', async () => {
+  const h = await setup()
+  const dispose = h.ctx.tools.addVisibilityFilter({
+    appliesTo: definition => definition.name === 'toolB',
+    hidden: () => true,
+  })
+  expect(await h.names(agentWith('plain'))).toEqual(['toolA'])
+
+  dispose()
+  expect(await h.names(agentWith('plain'))).toEqual(['toolA', 'toolB'])
+})
+
+it('hides the union of several plugins rules', async () => {
+  const h = await setup()
+  h.ctx.tools.addVisibilityFilter({
+    appliesTo: definition => definition.name === 'toolA',
+    hidden: () => true,
+  })
+  h.ctx.tools.addVisibilityFilter({
+    appliesTo: definition => definition.name === 'toolB',
+    hidden: () => true,
+  })
+
+  // Each plugin hides its own tool without knowing the other exists; both disappear.
+  expect(await h.names(agentWith('plain'))).toEqual([])
+})
+
+it('treats a throwing rule as not hiding', async () => {
+  const h = await setup()
+  h.ctx.tools.addVisibilityFilter({
+    appliesTo: definition => definition.name === 'toolA',
+    hidden: () => { throw new Error('broken connector') },
+  })
+  h.ctx.tools.addVisibilityFilter({
+    appliesTo: () => { throw new Error('broken matcher') },
+    hidden: () => true,
+  })
+
+  // A broken plugin must not empty the model's tool list.
+  expect(await h.names(agentWith('plain'))).toEqual(['toolA', 'toolB'])
+})
+
+it('leaves programmatic reads complete', async () => {
+  const h = await setup()
+  h.ctx.tools.addVisibilityFilter({
+    appliesTo: definition => definition.name === 'toolB',
+    hidden: () => true,
+  })
+  const agent = agentWith('plain')
+
+  // Inspection and dispatch stay whole: plugins keep seeing each other's tools, and the filter only
+  // governs what the step offers the model.
+  expect(h.ctx.tools.definitions(agent).map(definition => definition.name)).toEqual(['toolA', 'toolB'])
+  expect(h.ctx.tools.get('toolB', agent)?.name).toBe('toolB')
+  expect(h.ctx.tools.executable('toolB', agent)?.name).toBe('toolB')
+})
