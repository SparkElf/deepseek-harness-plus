+/**
+ * Structured mentions declared by one draft, in document order.
+ *
+ * Only `appearance: 'mention'` chips qualify: a source opts in when it inserts through
+ * `PickOutcome.insert`, and the host plugin that owns the roster reads the ids instead of parsing
+ * `@name` out of the text (which would misread a code sample and let any message smuggle itself
+ * into a routing decision). The same item picked twice is one mention.
+ * @param occurrences - chip occurrences projected from the editor.
+ * @returns `{sourceId, itemId, displayName}` records, or undefined when the draft declared none.
+ */
+export const collectMentions = (occurrences: readonly Occurrence[]): readonly SessionMentionRef[] | undefined => {
+  const seen = new Set<string>()
+  const mentions: SessionMentionRef[] = []
+  for (const occurrence of occurrences) {
+    if (occurrence.appearance !== 'mention') continue
+    const key = occurrence.source + '\u0000' + occurrence.ref
+    if (seen.has(key)) continue
+    seen.add(key)
+    mentions.push({ sourceId: occurrence.source, itemId: occurrence.ref, displayName: occurrence.label })
+  }
+  return mentions.length === 0 ? undefined : mentions
+}
