index 0000000000..7439cbfff0
--- /dev/null
+++ b/packages/client/ui-conversation/tests/mentions.client.spec.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest'
+import type { Occurrence } from '../src/client/contract/draft-editor.ts'
+import { collectMentions } from '../src/client/input/facade.ts'
+
+/** One projected chip occurrence; only the fields the collector reads are interesting. */
+const occurrence = (patch: Partial<Occurrence> & Pick<Occurrence, 'source' | 'ref'>): Occurrence => ({
+  occurrenceId: 1,
+  offset: 0,
+  length: 4,
+  label: 'label',
+  clipboardText: '@label',
+  ...patch,
+})
+
+describe('collecting declared mentions', () => {
+  it('takes mention chips only, in document order', () => {
+    const mentions = collectMentions([
+      occurrence({ source: 'reference', ref: 'src/a.ts', appearance: 'file', label: 'a.ts' }),
+      occurrence({ source: 'roster', ref: 'u-1', appearance: 'mention', label: '张三' }),
+      occurrence({ source: 'roster', ref: 'u-2', appearance: 'mention', label: '李四' }),
+    ])
+
+    // A file chip is a reference the model reads, not an identity a host plugin routes on.
+    expect(mentions).toEqual([
+      { sourceId: 'roster', itemId: 'u-1', displayName: '张三' },
+      { sourceId: 'roster', itemId: 'u-2', displayName: '李四' },
+    ])
+  })
+
+  it('reports one mention when the same item is picked twice', () => {
+    const mentions = collectMentions([
+      occurrence({ source: 'roster', ref: 'u-1', appearance: 'mention', label: '张三' }),
+      occurrence({ source: 'roster', ref: 'u-1', appearance: 'mention', label: '张三' }),
+    ])
+
+    expect(mentions).toEqual([{ sourceId: 'roster', itemId: 'u-1', displayName: '张三' }])
+  })
+
+  it('answers undefined for a draft that declared none', () => {
+    // Undefined, not an empty array: the sink keeps its original argument shape, so callers and
+    // test doubles that never saw a mention stay unchanged.
+    expect(collectMentions([])).toBeUndefined()
+    expect(collectMentions([occurrence({ source: 'reference', ref: 'x', appearance: 'session' })])).toBeUndefined()
+  })
+})
