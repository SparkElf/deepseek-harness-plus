+describe('WorkspaceRegistry storage restore', () => {
+  const contexts: Context[] = []
+
+  afterEach(async () => {
+    for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+  })
+
+  it('serves the replaced baseline, not the pre-restore window, once the restore returns', async () => {
+    const kept = await makeDir('restore-kept')
+    const restored = await makeDir('restore-kept-2')
+    const h = await harness({ sessions: [header('kept', kept, 100)] })
+    contexts.push(h.ctx)
+    const created = await h.registry.create(kept)
+    expect(h.registry.list().map(workspace => workspace.id)).toEqual([created.id])
+
+    // A restore replaces the durable medium wholesale: the registry must
+    // observe the replacement only after reopening, never the old window.
+    const id = WorkspaceId('restored-workspace')
+    const replaced = await h.registry.withStorageRestore(async () => {
+      const medium = h.pool.media.get('workspace')!
+      medium.tables.set('workspaces', new Map([[id, {
+        path: restored,
+        title: 'restored',
+        sessionIds: [],
+        createdAt: '1970-01-01T00:00:01.000Z',
+        updatedAt: '1970-01-01T00:00:01.000Z',
+      }]]))
+      medium.global = {
+        initialized: true,
+        workspaceIds: [id],
+        archivedSessionIds: [SessionId('archived-before-restore')],
+        pinnedSessionIds: [],
+      }
+      return 'replaced'
+    })
+
+    expect(replaced).toBe('replaced')
+    // Both the record set and the registry-global archive set come from the
+    // reopened domain; the pre-restore workspace and archive set are gone.
+    expect(h.registry.list().map(workspace => workspace.path)).toEqual([restored])
+    expect(h.registry.archivedSessionIds).toEqual([SessionId('archived-before-restore')])
+    expect(h.registry.list().map(workspace => workspace.id)).not.toContain(created.id)
+  })
+
+  it('reopens through startup bootstrap so a restored empty baseline is rebuilt', async () => {
+    const dir = await makeDir('restore-rebuild')
+    const h = await harness({ sessions: [header('rebuild', dir, 100)] })
+    contexts.push(h.ctx)
+    await h.registry.create(dir)
+    expect(h.registry.list()).toHaveLength(1)
+
+    await h.registry.withStorageRestore(async () => {
+      const medium = h.pool.media.get('workspace')!
+      medium.tables.set('workspaces', new Map())
+      medium.global = null
+    })
+
+    // The restored medium carries no initialized marker, so the reopened
+    // registry bootstraps the header history again instead of serving a stale cache.
+    expect(storedState(h.pool).initialized).toBe(true)
+    expect(h.registry.list()).toHaveLength(1)
+  })
+
+  it('rebuilds every cache on the restored baseline after the replacement throws', async () => {
+    const dir = await makeDir('restore-throws')
+    const h = await harness({ sessions: [header('throws', dir, 100)] })
+    contexts.push(h.ctx)
+    await h.registry.create(dir)
+
+    await expect(h.registry.withStorageRestore(async () => {
+      const medium = h.pool.media.get('workspace')!
+      medium.tables.set('workspaces', new Map())
+      medium.global = null
+      throw new Error('replacement failed')
+    })).rejects.toThrow('replacement failed')
+
+    // The reopen runs in the finally arm, so the registry is still usable:
+    // the restored empty medium is bootstrapped from the Session headers again.
+    expect(h.registry.list().map(workspace => workspace.path)).toEqual([dir])
+    await expect(h.registry.create(dir)).resolves.toBeDefined()
+  })
+
+  it('serializes a queued mutation behind the restore it was issued during', async () => {
+    const dir = await makeDir('restore-queued')
+    const h = await harness({ sessions: [header('queued', dir, 100)] })
+    contexts.push(h.ctx)
+    const created = await h.registry.create(dir)
+    const order: string[] = []
+    // The restore takes the registry queue slot synchronously, so the delete
+    // issued next runs only after the domain was closed and reopened.
+    const restoring = h.registry.withStorageRestore(async () => { order.push('restore') })
+    const deleting = h.registry.delete(created.id).then((ok) => { order.push('delete'); return ok })
+    await Promise.all([restoring, deleting])
+    expect(order).toEqual(['restore', 'delete'])
+    expect(await deleting).toBe(true)
+    expect(h.registry.list()).toEqual([])
+  })
+})
