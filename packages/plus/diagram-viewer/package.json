{
  "name": "@sparkelf/dsh-client-ui-diagram-viewer",
  "version": "0.2.1-alpha.28",
  "description": "Renders draw.io and XMind files in the dsh-better-sidebar file viewer.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@types/react": "~18.3.1",
    "dsh-better-sidebar": "^0.24.1",
    "react": "^18.3.1",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3"
  }
}
