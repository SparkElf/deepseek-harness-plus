{
  "name": "@sparkelf/dsh-plugin-mcp-credentials",
  "description": "Official MCP client replacement with credential-backed Streamable HTTP Bearer authentication",
  "version": "0.1.0-rc.18",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/deepseek-harness-plus.git",
    "directory": "packages/plus/mcp-credentials"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-invariants": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-scope": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-subprocess": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-timeout": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.1.3-alpha.1",
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.3-alpha.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^"
  }
}
