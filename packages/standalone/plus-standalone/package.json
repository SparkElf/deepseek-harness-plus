{
  "name": "@sparkelf/dsh-plus-standalone",
  "description": "Install and run DeepSeek Harness Plus from the registry: no source checkout and no build.",
  "version": "0.1.0-rc.41",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/standalone/plus-standalone"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-plus": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:>=0.1.5-rc.2",
    "@sparkelf/dsh-plus": "workspace:0.1.0-rc.41",
    "@changfenhuang/dsh-genui": "0.9.9",
    "@sparkelf/dsh-mineru": "0.1.2",
    "@sparkelf/dsh-officecli": "0.1.2",
    "@sparkelf/dsh-plugin-supervisor": "0.1.5",
    "dsh-sql-workbench": "0.5.1",
    "@sparkelf/dsh-workbench-vault": "0.1.2",
    "@sparkelf/dsh-ssh-manager": "0.7.2",
    "@sparkelf/dsh-api-client": "0.5.1",
    "@huanlin/dsh-plugin-better-locale": "0.4.1",
    "dsh-better-sidebar": "0.19.1",
    "@sparkelf/dsh-plugin-better-sidebar-office": "0.2.1",
    "@sparkelf/dsh-office-viewer-fonts": "0.1.2",
    "dsh-video-preview": "0.1.4",
    "@sparkelf/dsh-mobile-bridge": ">=0.2.11",
    "dshmarket": ">=1.45.1",
    "semver": ">=7.7.3",
    "yaml": ">=2.9.0"
  },
  "dshPlusStandalone": {
    "formatVersion": 1,
    "profile": "plus",
    "bundles": [
      "@deepseek-ai/dsh-base",
      "@deepseek-ai/dsh-web-app",
      "@sparkelf/dsh-mineru",
      "@sparkelf/dsh-officecli",
      "@sparkelf/dsh-mobile-bridge",
      "dshmarket",
      "@huanlin/dsh-plugin-better-locale",
      "dsh-better-sidebar",
      "@sparkelf/dsh-plugin-better-sidebar-office",
      "@sparkelf/dsh-office-viewer-fonts",
      "dsh-video-preview",
      "@changfenhuang/dsh-genui",
      "@sparkelf/dsh-plugin-supervisor",
      "@sparkelf/dsh-plus",
      "dsh-sql-workbench",
      "@sparkelf/dsh-ssh-manager",
      "@sparkelf/dsh-api-client"
    ],
    "allowBuilds": {
      "@deepseek-ai/dsh-subprocess-local": true,
      "@google/genai": false,
      "@officecli/officecli": true,
      "cpu-features": false,
      "koffi": true,
      "node-pty": true,
      "oracledb": true,
      "protobufjs": false,
      "ssh2": true
    },
    "peerOverrides": [
      {
        "name": "@huanlin/dsh-plugin-better-locale",
        "version": "0.4.1",
        "reason": "dsh-better-sidebar@0.19.1 declares ^0.1.0, which 0.1.5-rc.2 does not satisfy"
      },
      {
        "name": "dsh-better-sidebar",
        "version": "0.19.1",
        "reason": "@sparkelf/dsh-plugin-better-sidebar-office@0.2.1 declares ^0.17.0, which 0.1.5-rc.2 does not satisfy"
      },
      {
        "name": "@deepseek-ai/dsh-settings",
        "version": "0.1.5-rc.2",
        "reason": "@sparkelf/dsh-mobile-bridge@>=0.2.11 declares 0.1.5-alpha.1, which 0.1.5-rc.2 does not satisfy"
      },
      {
        "name": "@deepseek-ai/dsh-client-ui-slots",
        "version": "0.1.5-rc.2",
        "reason": "@sparkelf/dsh-mobile-bridge@>=0.2.11 declares 0.1.5-alpha.1, which 0.1.5-rc.2 does not satisfy"
      },
      {
        "name": "@deepseek-ai/dsh-client-ui-primitives",
        "version": "0.1.5-rc.2",
        "reason": "@sparkelf/dsh-mobile-bridge@>=0.2.11 declares 0.1.5-alpha.1, which 0.1.5-rc.2 does not satisfy"
      }
    ]
  },
  "private": false,
  "overrides": {
    "@huanlin/dsh-plugin-better-locale": "0.4.1",
    "dsh-better-sidebar": "0.19.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "npm:@sparkelf/dsh-client-ui-primitives@0.1.5-rc.6",
    "@deepseek-ai/dsh-agent-presets": "npm:@sparkelf/dsh-agent-presets@0.1.5-rc.6",
    "@deepseek-ai/dsh-api-gateway": "npm:@sparkelf/dsh-api-gateway@0.1.5-rc.6",
    "@deepseek-ai/dsh-api-session-controller": "npm:@sparkelf/dsh-api-session-controller@0.1.5-rc.6",
    "@deepseek-ai/dsh-client-connection": "npm:@sparkelf/dsh-client-connection@0.1.5-rc.6",
    "@deepseek-ai/dsh-client-ui-agent-preset": "npm:@sparkelf/dsh-client-ui-agent-preset@0.1.5-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "npm:@sparkelf/dsh-client-ui-conversation@0.1.5-rc.6",
    "@deepseek-ai/dsh-client-ui-deliverables": "npm:@sparkelf/dsh-client-ui-deliverables@0.1.5-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "npm:@sparkelf/dsh-client-ui-layout@0.1.5-rc.6",
    "@deepseek-ai/dsh-client-ui-model-selection": "npm:@sparkelf/dsh-client-ui-model-selection@0.1.5-rc.6",
    "@deepseek-ai/dsh-client-ui-settings-models": "npm:@sparkelf/dsh-client-ui-settings-models@0.1.5-rc.6",
    "@deepseek-ai/dsh-client-ui-trajectory": "npm:@sparkelf/dsh-client-ui-trajectory@0.1.5-rc.6",
    "@deepseek-ai/dsh-host-frontend-static": "npm:@sparkelf/dsh-host-frontend-static@0.1.5-rc.6",
    "@deepseek-ai/dsh-host-webserver": "npm:@sparkelf/dsh-host-webserver@0.1.5-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "npm:@sparkelf/dsh-llm-pi-ai@0.1.5-rc.6",
    "@deepseek-ai/dsh-session-log-export": "npm:@sparkelf/dsh-session-log-export@0.1.5-rc.6",
    "@deepseek-ai/dsh-tools": "npm:@sparkelf/dsh-tools@0.1.5-rc.6",
    "@deepseek-ai/dsh-web-app": "npm:@sparkelf/dsh-web-app@0.1.5-rc.6",
    "@deepseek-ai/dsh-web-frontend": "npm:@sparkelf/dsh-web-frontend@0.1.5-rc.6",
    "@deepseek-ai/dsh-workspace": "npm:@sparkelf/dsh-workspace@0.1.5-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
